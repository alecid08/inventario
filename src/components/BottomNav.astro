---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const isInventario = pathname === base || pathname === `${base}/` || pathname === '/';
const isMovimientos = pathname.includes('/movimientos');
const isAlertas = pathname.includes('/alertas');
const isReportes = pathname.includes('/reportes');
---

<nav class="fixed bottom-0 left-0 right-0 max-w-lg mx-auto bg-surface-container-lowest shadow-lg px-2 py-1.5 flex justify-around items-center z-40 border-t border-surface-container">
  <!-- 1. Inventario -->
  <a href={`${base}/`} class={`flex flex-col items-center justify-center min-h-[48px] min-w-[48px] px-2 rounded-xl transition-colors active:scale-95 ${isInventario ? 'text-primary' : 'text-secondary hover:text-on-surface'}`}>
    <span class="material-symbols-outlined text-2xl" style={isInventario ? "font-variation-settings: 'FILL' 1;" : ""}>inventory_2</span>
    <span class={`text-[11px] font-label-sm mt-0.5 ${isInventario ? 'font-bold' : ''}`}>Inventario</span>
  </a>

  <!-- 2. Movimientos -->
  <a href={`${base}/movimientos/`} class={`flex flex-col items-center justify-center min-h-[48px] min-w-[48px] px-2 rounded-xl transition-colors active:scale-95 ${isMovimientos ? 'text-primary' : 'text-secondary hover:text-on-surface'}`}>
    <span class="material-symbols-outlined text-2xl" style={isMovimientos ? "font-variation-settings: 'FILL' 1;" : ""}>sync_alt</span>
    <span class={`text-[11px] font-label-sm mt-0.5 ${isMovimientos ? 'font-bold' : ''}`}>Movimientos</span>
  </a>

  <!-- 3. Alertas -->
  <a href={`${base}/alertas/`} class={`flex flex-col items-center justify-center min-h-[48px] min-w-[48px] px-2 rounded-xl relative active:scale-95 ${isAlertas ? 'text-primary' : 'text-secondary hover:text-on-surface'}`}>
    <div class="relative">
      <span class="material-symbols-outlined text-2xl" style={isAlertas ? "font-variation-settings: 'FILL' 1;" : ""}>notifications_active</span>
      <span class="absolute -top-1 -right-2 bg-error text-on-error text-[10px] font-bold px-1.5 py-0.2 rounded-full ring-2 ring-surface-container-lowest transition-all" id="bottomNavAlertBadge">
        4
      </span>
    </div>
    <span class={`text-[11px] font-label-sm mt-0.5 ${isAlertas ? 'font-bold' : ''}`}>Alertas</span>
  </a>

  <!-- 4. Reportes -->
  <a href={`${base}/reportes/`} class={`flex flex-col items-center justify-center min-h-[48px] min-w-[48px] px-2 rounded-xl transition-colors active:scale-95 ${isReportes ? 'text-primary' : 'text-secondary hover:text-on-surface'}`}>
    <span class="material-symbols-outlined text-2xl" style={isReportes ? "font-variation-settings: 'FILL' 1;" : ""}>assessment</span>
    <span class={`text-[11px] font-label-sm mt-0.5 ${isReportes ? 'font-bold' : ''}`}>Reportes</span>
  </a>
</nav>

<script is:inline>
  function updateNavAlertBadge() {
    const badge = document.getElementById('bottomNavAlertBadge');
    if (!badge) return;
    try {
      const raw = localStorage.getItem('stock_movil_inventory_v1');
      if (raw) {
        const items = JSON.parse(raw);
        const alertCount = items.filter(i => (parseInt(i.stock, 10) || 0) < (parseInt(i.minStock, 10) || 5)).length;
        if (alertCount === 0) {
          badge.classList.add('hidden');
        } else {
          badge.classList.remove('hidden');
          badge.textContent = alertCount;
        }
      }
    } catch (e) {}
  }

  document.addEventListener('DOMContentLoaded', updateNavAlertBadge);
  window.addEventListener('inventory-updated', updateNavAlertBadge);
  window.addEventListener('storage', updateNavAlertBadge);
  updateNavAlertBadge();
</script>
