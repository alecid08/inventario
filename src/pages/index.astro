---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stock Móvil - Inventario de Piso">
  <header class="fixed top-0 w-full z-50 pt-safe bg-surface-container-lowest/90 backdrop-blur-xl shadow-sm">
    <div class="h-16 px-gutter-mobile flex items-center justify-between">
      <div class="flex items-center gap-space-sm min-w-0">
        <div class="w-10 h-10 rounded-full overflow-hidden bg-surface-container-low flex items-center justify-center flex-shrink-0 shadow-sm">
          <img alt="Logo de Marca" title="Logo de Marca" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida/AEtjO1WnIL8J1nkSAuADgPhfbUlLwgFXz8vZdoJPPpWXJLY2_mYTAD5yQfM6Qs1zSTarkAR05ibks32eBcxAm0ShFgfAtbtI1WjwSL-gsbiOnjSm6TIPGRgFdiVaDGN-IkCEHH7IvkGQNu6ebrvTZOxlnXQI_N-5eOpes7RPMyQgwmdv8_BP957lTZUKNroTwD_pCgkM_9GTIomaHwCPGFUPMOjX-djCYO7BrdYZZaBZi13edGMitYflmLK1zRnj"/>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-label-md text-label-md text-on-surface truncate leading-tight">Stock Móvil</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 truncate">
            <span class="w-1.5 h-1.5 rounded-full bg-tertiary flex-shrink-0"></span>
            <span class="truncate">Sucursal Central · Tienda #102</span>
          </span>
        </div>
      </div>
      <div class="flex items-center gap-space-xs">
        <button aria-label="Escanear código de barras" class="w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container-low active:bg-surface-container transition-colors" id="btnScanHeader" title="Escanear producto" type="button">
          <span class="material-symbols-outlined text-[24px]">barcode_scanner</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile pt-16 pb-20">
    <div class="flex flex-col w-full pb-24">
      <!-- Interactive Stock Quick Adjust Modal -->
      <div class="hidden fixed inset-0 z-50 flex items-end justify-center bg-on-surface/40 backdrop-blur-sm transition-all duration-200" id="quickAdjustModal">
        <div class="w-full max-w-lg bg-surface-container-lowest rounded-t-2xl p-space-lg shadow-2xl flex flex-col gap-space-md animate-in slide-in-from-bottom duration-200">
          <div class="w-10 h-1.5 bg-outline-variant/60 rounded-full self-center mb-1"></div>
          <div class="flex items-center justify-between">
            <div>
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-wider">Conteo de Mostrador</span>
              <h3 class="font-headline-sm text-headline-sm text-on-surface" id="modalProductName">Nombre del Producto</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant" id="modalProductSku">SKU-000</p>
            </div>
            <button class="w-10 h-10 flex items-center justify-center rounded-full text-secondary hover:bg-surface-container-low transition-colors" id="closeModalBtn" type="button">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          <div class="flex items-center justify-center gap-space-lg py-space-md bg-surface-container-low rounded-xl">
            <button class="w-14 h-14 rounded-xl bg-surface-container-lowest text-primary shadow-sm flex items-center justify-center active:scale-95 transition-transform" id="modalDecBtn" type="button">
              <span class="material-symbols-outlined text-[28px]">remove</span>
            </button>
            <div class="flex flex-col items-center">
              <span class="font-display text-display text-on-surface" id="modalStockDisplay">3</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">de 10 max.</span>
            </div>
            <button class="w-14 h-14 rounded-xl bg-primary text-on-primary shadow-sm flex items-center justify-center active:scale-95 transition-transform" id="modalIncBtn" type="button">
              <span class="material-symbols-outlined text-[28px]">add</span>
            </button>
          </div>
          <div class="flex gap-space-sm pt-2">
            <button class="flex-1 h-touch-min rounded-xl bg-surface-container text-on-surface font-label-md text-label-md flex items-center justify-center" id="cancelModalBtn" type="button">
              Cancelar
            </button>
            <button class="flex-1 h-touch-min rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-md flex items-center justify-center gap-1.5" id="saveModalBtn" type="button">
              <span class="material-symbols-outlined text-[20px]">check</span>
              Confirmar Conteo
            </button>
          </div>
        </div>
      </div>

      <!-- Add New Product Modal -->
      <div class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-on-surface/40 backdrop-blur-sm transition-all duration-200" id="newProductModal">
        <div class="w-full max-w-lg bg-surface-container-lowest rounded-t-2xl sm:rounded-2xl p-space-lg shadow-2xl flex flex-col gap-space-md max-h-[90vh] overflow-y-auto">
          <div class="flex items-center justify-between border-b border-surface-container pb-3">
            <div class="flex items-center gap-2">
              <div class="w-9 h-9 rounded-xl bg-primary-container text-on-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">add_box</span>
              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">Añadir Accesorio a Estante</h3>
            </div>
            <button class="w-9 h-9 flex items-center justify-center rounded-full text-secondary hover:bg-surface-container transition-colors" id="closeNewModalBtn" type="button">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          <form class="flex flex-col gap-space-sm" id="newProductForm">
            <div>
              <label class="block font-label-sm text-label-sm text-on-surface mb-1" for="newProdName">Nombre del accesorio <span class="text-error">*</span></label>
              <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all" id="newProdName" placeholder="Ej. Funda MagSafe Silicona iPhone 16" required type="text"/>
            </div>
            <div class="grid grid-cols-2 gap-space-sm">
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface mb-1" for="newProdSku">Código SKU</label>
                <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-sku-code text-sku-code focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all" id="newProdSku" placeholder="SKU-888" type="text"/>
              </div>
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface mb-1" for="newProdCat">Categoría</label>
                <select class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:outline-none" id="newProdCat">
                  <option value="Fundas">Fundas</option>
                  <option value="Cargas">Cargas &amp; Cables</option>
                  <option value="Micas">Micas 9D</option>
                  <option value="Audio">Audio</option>
                  <option value="Auto">Auto</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-space-sm">
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface mb-1" for="newProdStock">Conteo Físico Inicial</label>
                <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none opacity-80 cursor-not-allowed" id="newProdStock" readonly title="Stock inicial estándar asignado a 10 unidades por defecto" type="number" value="10"/>
              </div>
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface mb-1" for="newProdLoc">Ubicación / Estante</label>
                <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:outline-none" id="newProdLoc" placeholder="Vitrina A-1" type="text"/>
              </div>
            </div>
            <div class="flex gap-space-sm pt-3">
              <button class="flex-1 h-12 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md" id="cancelNewModalBtn" type="button">
                Cancelar
              </button>
              <button class="flex-1 h-12 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-md flex items-center justify-center gap-1.5" type="submit">
                <span class="material-symbols-outlined text-[20px]">save</span>
                <span>Guardar Producto</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Search & Barcode Quick Access Bar -->
      <div class="flex flex-col gap-space-sm mb-space-md">
        <div class="flex items-center gap-space-xs">
          <div class="relative flex-1 flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-secondary text-[22px] pointer-events-none">search</span>
            <input class="w-full h-touch-min pl-11 pr-10 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-outline font-body-md text-body-md shadow-sm focus:outline-none focus:bg-surface-container-low transition-all" id="inventorySearchInput" placeholder="Buscar por accesorio, modelo o SKU..." type="text"/>
            <button class="hidden absolute right-3 w-7 h-7 flex items-center justify-center rounded-full text-secondary hover:bg-surface-container" id="clearSearchBtn" type="button">
              <span class="material-symbols-outlined text-[18px]">cancel</span>
            </button>
          </div>
          <button class="h-touch-min w-touch-min flex-shrink-0 flex items-center justify-center rounded-xl bg-surface-container-lowest text-secondary shadow-sm active:bg-surface-container transition-colors" id="btnFilterToggle" title="Filtros avanzados" type="button">
            <span class="material-symbols-outlined text-[22px]">tune</span>
          </button>
        </div>
        <!-- Category Filter Chips -->
        <div class="flex items-center gap-space-2xs overflow-x-auto no-scrollbar py-0.5" id="categoryChips">
          <button class="chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-on-surface text-surface-container-lowest shadow-sm flex items-center gap-1 flex-shrink-0 transition-colors" data-category="all" type="button">
            <span>Todos</span>
            <span class="px-1.5 py-0.2 rounded-full bg-surface-container-lowest/20 text-[11px]" id="badgeCountAll">8</span>
          </button>
          <button class="chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-secondary shadow-sm flex items-center gap-1 flex-shrink-0 hover:text-on-surface transition-colors" data-category="Fundas" type="button">
            <span>Fundas</span>
          </button>
          <button class="chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-secondary shadow-sm flex items-center gap-1 flex-shrink-0 hover:text-on-surface transition-colors" data-category="Cargas" type="button">
            <span>Cargas &amp; Cables</span>
          </button>
          <button class="chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-secondary shadow-sm flex items-center gap-1 flex-shrink-0 hover:text-on-surface transition-colors" data-category="Micas" type="button">
            <span>Micas 9D</span>
          </button>
          <button class="chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-secondary shadow-sm flex items-center gap-1 flex-shrink-0 hover:text-on-surface transition-colors" data-category="Audio" type="button">
            <span>Audio</span>
          </button>
          <button class="chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-secondary shadow-sm flex items-center gap-1 flex-shrink-0 hover:text-on-surface transition-colors" data-category="Auto" type="button">
            <span>Auto</span>
          </button>
        </div>
      </div>

      <!-- Operational Metrics & Count Summary -->
      <div class="bg-surface-container-low rounded-xl p-space-sm mb-space-md flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-space-xs">
          <div class="w-8 h-8 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[20px]">layers</span>
          </div>
          <div class="flex flex-col">
            <span class="font-label-md text-label-md text-on-surface leading-snug">Stock de Piso</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant" id="productCountSubtitle">Mostrando 8 productos · 3 en estado revisable</span>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-full font-label-sm text-label-sm bg-error-container text-on-error-container font-semibold flex items-center gap-1 shadow-sm" id="topAlertPill">
          <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
          <span id="topAlertText">3 Alertas</span>
        </span>
      </div>

      <!-- Inventory Items List -->
      <div class="flex flex-col gap-space-sm" id="inventoryList">
        <!-- Rendered dynamically -->
      </div>

      <!-- Empty Search State -->
      <div class="hidden flex-col items-center justify-center py-space-2xl text-center" id="emptyInventoryState">
        <div class="w-16 h-16 rounded-full bg-surface-container-low flex items-center justify-center text-secondary mb-space-sm">
          <span class="material-symbols-outlined text-[32px]">inventory_2</span>
        </div>
        <h4 class="font-headline-sm text-headline-sm text-on-surface mb-1">Sin coincidencias</h4>
        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[240px]">No se encontraron accesorios que coincidan con la búsqueda actual.</p>
        <button class="mt-space-md px-4 py-2 bg-primary text-on-primary rounded-xl font-label-sm text-label-sm shadow-sm" id="resetFiltersBtn" type="button">
          Restablecer lista
        </button>
      </div>

      <!-- Floating Action Button (FAB) -->
      <div class="fixed right-4 bottom-20 z-40">
        <button aria-label="Añadir producto a estante" class="w-14 h-14 rounded-full bg-primary-container text-on-primary flex items-center justify-center shadow-lg active:scale-95 transition-transform hover:shadow-xl focus:outline-none" id="fabBtn" title="Añadir producto a estante" type="button">
          <span class="material-symbols-outlined text-[30px]">add</span>
        </button>
      </div>

      <!-- Micro-interaction Toast -->
      <div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200" id="stockToast">
        <span class="material-symbols-outlined text-tertiary-fixed text-[18px]" id="stockToastIcon">check_circle</span>
        <span id="stockToastText">Stock actualizado correctamente</span>
      </div>
    </div>
  </main>

  <script>
    import { getStoredInventory, saveInventory, deactivateProduct, createProduct } from '../utils/inventoryStore.js';
    import type { Product } from '../types/inventory';

    let inventory: Product[] = getStoredInventory(false);
    let activeCardSku: string | null = null;
    let currentModalStock = 0;
    let currentCategory = 'all';

    function showToast(text: string, isError = false) {
      const toast = document.getElementById('stockToast');
      const toastText = document.getElementById('stockToastText');
      const toastIcon = document.getElementById('stockToastIcon');
      if (!toast || !toastText) return;
      toastText.textContent = text;
      if (toastIcon) toastIcon.textContent = isError ? 'error' : 'check_circle';
      toast.className = `fixed top-20 left-1/2 -translate-x-1/2 z-50 ${isError ? 'bg-error-container text-on-error-container' : 'bg-on-surface text-surface'} px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-100 transition-opacity duration-200`;
      setTimeout(() => {
        toast.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200';
      }, 2600);
    }

    function renderInventoryList() {
      inventory = getStoredInventory(false);
      const container = document.getElementById('inventoryList');
      if (!container) return;
      container.innerHTML = '';

      inventory.forEach(item => {
        const isLow = item.stock < (item.minStock || 5);
        const card = document.createElement('div');
        card.className = 'inventory-card bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col gap-space-xs relative overflow-hidden transition-all duration-150 active:scale-[0.99]';
        card.setAttribute('data-id', item.id);
        card.setAttribute('data-sku', item.sku);
        card.setAttribute('data-name', item.name);
        card.setAttribute('data-category', item.category);
        card.setAttribute('data-stock', item.stock.toString());

        card.innerHTML = `
          <div class="absolute top-0 left-0 bottom-0 w-1.5 ${isLow ? 'bg-error' : 'bg-tertiary'}"></div>
          <div class="flex items-center gap-space-sm pl-2">
            <div class="w-14 h-14 rounded-xl bg-surface-container-low overflow-hidden flex-shrink-0 flex items-center justify-center shadow-inner">
              <img alt="${item.name}" title="${item.name}" class="w-full h-full object-cover" src="${item.img || 'https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww'}"/>
            </div>
            <div class="flex-1 min-w-0 flex flex-col">
              <div class="flex items-start justify-between gap-1">
                <h4 class="font-label-md text-label-md text-on-surface truncate">${item.name}</h4>
                <div class="flex items-center gap-1">
                  <span class="status-badge px-2 py-0.5 rounded-full font-label-sm text-label-sm ${isLow ? 'bg-error-container text-on-error-container' : 'bg-tertiary-fixed text-on-tertiary-fixed'} font-bold flex-shrink-0">
                    ${isLow ? 'Revisable' : 'OK'}
                  </span>
                  <button class="btn-deactivate p-1 rounded-md text-secondary hover:bg-error-container hover:text-error transition-colors" data-sku="${item.sku}" title="Desactivar producto (Soft delete)" type="button">
                    <span class="material-symbols-outlined text-[18px]">visibility_off</span>
                  </button>
                </div>
              </div>
              <span class="font-body-sm text-body-sm text-on-surface-variant truncate mt-0.5">${item.category} · ${item.sku}</span>
              <div class="flex items-center justify-between mt-2 gap-2 flex-wrap sm:flex-nowrap">
                <div class="flex items-center gap-2">
                  <span class="stock-text font-sku-code text-sku-code ${isLow ? 'text-error font-bold' : 'text-on-surface font-semibold'}">${item.stock} / ${item.maxStock || 10}</span>
                  <div class="w-16 sm:w-20 h-1.5 bg-surface-container rounded-full overflow-hidden">
                    <div class="stock-bar h-full ${isLow ? 'bg-error' : 'bg-tertiary'} rounded-full" style="width: ${Math.min(100, item.stock * 10)}%"></div>
                  </div>
                </div>
                <div class="flex items-center gap-1 shrink-0">
                  <button class="btn-card-dec w-8 h-8 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high flex items-center justify-center active:scale-95 transition-all" data-sku="${item.sku}" title="Descontar 1 unidad" type="button">
                    <span class="material-symbols-outlined text-[16px]">remove</span>
                  </button>
                  <button class="btn-card-inc w-8 h-8 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high flex items-center justify-center active:scale-95 transition-all" data-sku="${item.sku}" title="Sumar 1 unidad" type="button">
                    <span class="material-symbols-outlined text-[16px]">add</span>
                  </button>
                  <button class="btn-adjust px-2.5 py-1 rounded-lg bg-surface-container-low text-primary hover:bg-surface-container font-label-sm text-label-sm flex items-center gap-1 active:bg-primary active:text-on-primary transition-colors" data-sku="${item.sku}" type="button">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Ajustar</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      attachCardEventListeners();
      applyFilters();
    }

    function attachCardEventListeners() {
      document.querySelectorAll('.btn-card-inc').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const sku = btn.getAttribute('data-sku');
          if (sku) updateProductStock(sku, 1);
        });
      });

      document.querySelectorAll('.btn-card-dec').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const sku = btn.getAttribute('data-sku');
          if (sku) updateProductStock(sku, -1);
        });
      });

      document.querySelectorAll('.btn-deactivate').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const sku = btn.getAttribute('data-sku');
          if (!sku) return;
          const item = inventory.find(i => i.sku === sku);
          if (item && confirm(`¿Deseas desactivar "${item.name}"? El producto se mantendrá en el sistema con su historial intacto.`)) {
            deactivateProduct(sku);
            renderInventoryList();
            showToast(`Producto "${item.name}" desactivado correctamente.`);
          }
        });
      });

      document.querySelectorAll('.btn-adjust').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const sku = btn.getAttribute('data-sku');
          const item = inventory.find(i => i.sku === sku);
          if (!item) return;

          activeCardSku = sku;
          currentModalStock = item.stock;

          const modalName = document.getElementById('modalProductName');
          const modalSku = document.getElementById('modalProductSku');
          const modalDisplay = document.getElementById('modalStockDisplay');

          if (modalName) modalName.textContent = item.name;
          if (modalSku) modalSku.textContent = item.sku;
          if (modalDisplay) modalDisplay.textContent = currentModalStock.toString();

          document.getElementById('quickAdjustModal')?.classList.remove('hidden');
        });
      });
    }

    function updateProductStock(sku: string, delta: number) {
      const item = inventory.find(i => i.sku === sku);
      if (!item) return;
      let newStock = item.stock + delta;

      if (newStock > (item.maxStock || 10)) {
        showToast(`Rechazado: El stock no puede superar el tope máximo de ${item.maxStock || 10} unidades.`, true);
        return;
      }

      newStock = Math.max(0, newStock);
      item.stock = newStock;
      saveInventory(inventory);
      renderInventoryList();
      showToast(`${item.name}: Stock actualizado a ${newStock} unid.`);
    }

    function closeModal() {
      document.getElementById('quickAdjustModal')?.classList.add('hidden');
      activeCardSku = null;
    }

    document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
    document.getElementById('cancelModalBtn')?.addEventListener('click', closeModal);

    document.getElementById('modalIncBtn')?.addEventListener('click', () => {
      const modalDisplay = document.getElementById('modalStockDisplay');
      if (currentModalStock < 10) {
        currentModalStock++;
        if (modalDisplay) modalDisplay.textContent = currentModalStock.toString();
      } else {
        showToast('Bloqueo: No es posible superar 10 unidades.', true);
      }
    });

    document.getElementById('modalDecBtn')?.addEventListener('click', () => {
      const modalDisplay = document.getElementById('modalStockDisplay');
      if (currentModalStock > 0) {
        currentModalStock--;
        if (modalDisplay) modalDisplay.textContent = currentModalStock.toString();
      }
    });

    document.getElementById('saveModalBtn')?.addEventListener('click', () => {
      if (!activeCardSku) return;
      const item = inventory.find(i => i.sku === activeCardSku);
      if (item) {
        item.stock = currentModalStock;
        saveInventory(inventory);
        renderInventoryList();
        showToast(`${item.name}: Conteo confirmado a ${currentModalStock} unid.`);
      }
      closeModal();
    });

    const fabBtn = document.getElementById('fabBtn');
    const newProductModal = document.getElementById('newProductModal');
    const closeNewModalBtn = document.getElementById('closeNewModalBtn');
    const cancelNewModalBtn = document.getElementById('cancelNewModalBtn');
    const newProductForm = document.getElementById('newProductForm') as HTMLFormElement | null;

    fabBtn?.addEventListener('click', () => {
      newProductModal?.classList.remove('hidden');
    });

    function closeNewModal() {
      newProductModal?.classList.add('hidden');
      newProductForm?.reset();
    }

    closeNewModalBtn?.addEventListener('click', closeNewModal);
    cancelNewModalBtn?.addEventListener('click', closeNewModal);

    newProductForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('newProdName') as HTMLInputElement | null)?.value.trim();
      let sku = (document.getElementById('newProdSku') as HTMLInputElement | null)?.value.trim();
      const category = (document.getElementById('newProdCat') as HTMLSelectElement | null)?.value;
      const location = (document.getElementById('newProdLoc') as HTMLInputElement | null)?.value.trim() || 'Estante Principal';

      if (!name) return;

      const newItem = createProduct({
        name,
        sku,
        category,
        location
      });

      closeNewModal();
      renderInventoryList();
      showToast(`¡Accesorio ${newItem.sku} creado con stock estándar de 10 unid.!`);
    });

    function applyFilters() {
      const searchInput = document.getElementById('inventorySearchInput') as HTMLInputElement | null;
      const query = (searchInput?.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.inventory-card');

      let visibleCount = 0;
      let revisableCount = 0;

      cards.forEach(card => {
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const sku = (card.getAttribute('data-sku') || '').toLowerCase();
        const category = card.getAttribute('data-category') || '';
        const stock = parseInt(card.getAttribute('data-stock') || '0', 10);

        const matchesCat = (currentCategory === 'all') || (category === currentCategory);
        const matchesSearch = !query || name.includes(query) || sku.includes(query);

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
          if (stock < 5) revisableCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      const subtitle = document.getElementById('productCountSubtitle');
      if (subtitle) {
        subtitle.textContent = `Mostrando ${visibleCount} productos · ${revisableCount} en estado revisable`;
      }

      const totalAlerts = inventory.filter(i => i.stock < 5).length;
      const topAlertText = document.getElementById('topAlertText');
      if (topAlertText) topAlertText.textContent = `${totalAlerts} Alertas`;

      const badgeCountAll = document.getElementById('badgeCountAll');
      if (badgeCountAll) badgeCountAll.textContent = inventory.length.toString();

      const emptyState = document.getElementById('emptyInventoryState');
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
        }
      }
    }

    document.querySelectorAll('#categoryChips .chip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        currentCategory = target.getAttribute('data-category') || 'all';

        document.querySelectorAll('#categoryChips .chip-btn').forEach(b => {
          b.className = 'chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-secondary shadow-sm flex items-center gap-1 flex-shrink-0 hover:text-on-surface transition-colors';
        });
        target.className = 'chip-btn px-4 py-2 rounded-full font-label-sm text-label-sm bg-on-surface text-surface-container-lowest shadow-sm flex items-center gap-1 flex-shrink-0 transition-colors';

        applyFilters();
      });
    });

    const searchInput = document.getElementById('inventorySearchInput') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clearSearchBtn');

    searchInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (clearBtn) {
        if (val.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        applyFilters();
      }
    });

    window.addEventListener('inventory-updated', () => {
      renderInventoryList();
    });

    renderInventoryList();
  </script>
</Layout>
