---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stock Móvil - Registrar Movimiento">
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile">
    <div class="flex flex-col w-full pb-24 space-y-space-md">
      <!-- Header / Barra Superior Contextual -->
      <header class="flex flex-col space-y-space-xs pt-space-xs">
        <div class="flex items-center justify-between">
          <a href="/" aria-label="Volver atrás" class="flex items-center justify-center w-10 h-10 rounded-full bg-surface-container-low text-on-surface hover:bg-surface-container transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
          </a>
          <div class="flex items-center space-x-1.5 px-3 py-1 rounded-full bg-surface-container text-on-secondary-container text-label-sm font-label-sm">
            <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">storefront</span>
            <span>Sucursal Centro #102</span>
          </div>
        </div>
        <div class="pt-1">
          <h1 class="font-headline-lg text-headline-lg text-on-surface">Registrar Movimiento</h1>
          <p class="font-body-sm text-body-sm text-secondary">Control de entradas, salidas y ajustes de stock en tiempo real</p>
        </div>
      </header>

      <!-- SECCIÓN 1: Selector de Producto -->
      <section class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-sm">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            1. Seleccionar Producto <span class="text-error">*</span>
          </span>
          <button class="text-primary font-label-sm text-label-sm hover:underline flex items-center gap-0.5" id="btnToggleSelectModal" type="button">
            Cambiar Accesorio
          </button>
        </div>
        
        <!-- Dropdown / Select bar -->
        <div class="relative flex items-center bg-surface-container-low rounded-xl px-3 h-12 shadow-sm focus-within:bg-surface-container-lowest transition-all">
          <span class="material-symbols-outlined text-secondary text-[20px] mr-2">inventory_2</span>
          <select class="w-full bg-transparent text-on-surface font-body-md text-body-md focus:outline-none cursor-pointer" id="productSelectDropdown">
            <!-- Populated via script -->
          </select>
        </div>

        <!-- Tarjeta de Previsualización de Producto Seleccionado -->
        <div class="relative bg-surface-container-low rounded-xl p-3 flex gap-3 items-center overflow-hidden" id="selectedProductCard">
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-tertiary" id="selectedCardBorder"></div>
          <div class="w-16 h-16 rounded-lg bg-surface-container-highest flex items-center justify-center overflow-hidden shrink-0 shadow-inner">
            <img alt="Producto Seleccionado" title="Producto Seleccionado" class="w-full h-full object-cover" id="selectedCardImg" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww"/>
          </div>
          <div class="flex-1 min-w-0 space-y-1">
            <div class="flex items-center justify-between gap-1">
              <span class="font-label-sm text-label-sm text-secondary truncate" id="selectedCardCategory">Fundas &amp; Protección</span>
              <span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed text-[11px] font-label-sm font-semibold shrink-0" id="selectedCardStatus">
                OK
              </span>
            </div>
            <p class="font-headline-sm text-headline-sm text-on-surface truncate leading-tight" id="selectedCardTitle">Cargador Rápido 30W USB-C GaN</p>
            <div class="flex items-center justify-between text-sku-code font-sku-code">
              <span class="text-secondary tracking-wider text-[11px]" id="selectedCardSku">SKU-141</span>
              <span class="font-data-tabular text-data-tabular font-bold text-on-surface" id="selectedCardStock">8 disp.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 2: Tipo de Movimiento -->
      <section class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-sm">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            2. Tipo de Movimiento <span class="text-error">*</span>
          </span>
          <span class="text-label-sm font-label-sm text-error bg-error-container px-2 py-0.5 rounded-full" id="badge-tipo-resumen">
            Salida (-)
          </span>
        </div>
        <!-- Opciones en Grid -->
        <div class="grid grid-cols-1 gap-2" id="movement-type-group">
          <!-- 1. Despacho -->
          <label class="movement-card flex items-center justify-between p-3.5 rounded-xl cursor-pointer bg-primary-fixed text-on-primary-fixed shadow-sm transition-all" data-factor="-1" data-type="out">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">output</span>
              </div>
              <div class="min-w-0">
                <p class="font-label-lg text-label-lg font-semibold">Salida / Despacho de Piso</p>
                <p class="font-body-sm text-body-sm opacity-80 truncate">Entrega a cliente o traslado de vitrina</p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-error-container text-on-error-container font-semibold">- Salida</span>
              <div class="radio-indicator w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[14px]">check</span>
              </div>
            </div>
          </label>

          <!-- 2. Reposición de Bodega -->
          <label class="movement-card flex items-center justify-between p-3.5 rounded-xl cursor-pointer bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-factor="1" data-type="in">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-full bg-surface-container-highest text-primary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">input</span>
              </div>
              <div class="min-w-0">
                <p class="font-label-lg text-label-lg font-semibold">Entrada / Recepción de Stock</p>
                <p class="font-body-sm text-body-sm text-secondary truncate">Ingreso de accesorios a la vitrina de piso</p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-tertiary-fixed text-on-tertiary-fixed font-semibold">+ Entrada</span>
              <div class="radio-indicator w-5 h-5 rounded-full bg-surface-container-highest text-transparent flex items-center justify-center">
                <span class="material-symbols-outlined text-[14px]">check</span>
              </div>
            </div>
          </label>

          <!-- 3. Ajuste por conteo -->
          <label class="movement-card flex items-center justify-between p-3.5 rounded-xl cursor-pointer bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-factor="0" data-type="adjust">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-full bg-surface-container-highest text-secondary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">tune</span>
              </div>
              <div class="min-w-0">
                <p class="font-label-lg text-label-lg font-semibold">Ajuste Directo por Conteo Físico</p>
                <p class="font-body-sm text-body-sm text-secondary truncate">Fijar exactamente el número de existencias reales</p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-secondary-container text-on-secondary-container font-semibold">Ajuste</span>
              <div class="radio-indicator w-5 h-5 rounded-full bg-surface-container-highest text-transparent flex items-center justify-center">
                <span class="material-symbols-outlined text-[14px]">check</span>
              </div>
            </div>
          </label>
        </div>
      </section>

      <!-- SECCIÓN 3: Cantidad de Unidades -->
      <section class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-md">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            3. Cantidad de Unidades <span class="text-error">*</span>
          </span>
          <span class="font-label-sm text-label-sm text-secondary">Acción Rápida</span>
        </div>
        <!-- Stepper -->
        <div class="flex items-center justify-between bg-surface-container-low rounded-2xl p-2 shadow-inner">
          <button class="w-14 h-14 rounded-xl bg-surface-container-lowest text-on-surface hover:bg-surface-container-high active:scale-95 flex items-center justify-center transition-all shadow-sm" id="btn-dec" type="button">
            <span class="material-symbols-outlined text-[28px]">remove</span>
          </button>
          <div class="flex flex-col items-center justify-center">
            <input class="w-24 text-center font-display text-display bg-transparent text-primary font-bold focus:outline-none" id="input-qty" max="999" min="1" type="number" value="1"/>
            <span class="font-label-sm text-label-sm text-secondary -mt-1">unidad(es)</span>
          </div>
          <button class="w-14 h-14 rounded-xl bg-primary text-on-primary hover:opacity-90 active:scale-95 flex items-center justify-center transition-all shadow-sm" id="btn-inc" type="button">
            <span class="material-symbols-outlined text-[28px]">add</span>
          </button>
        </div>
        <!-- Pills de Incremento Rápido -->
        <div class="grid grid-cols-4 gap-2">
          <button class="btn-quick-add py-2.5 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm" data-val="1" type="button">+1</button>
          <button class="btn-quick-add py-2.5 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm" data-val="5" type="button">+5</button>
          <button class="btn-quick-add py-2.5 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm" data-val="10" type="button">+10</button>
          <button class="btn-quick-add py-2.5 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm" data-val="20" type="button">+20</button>
        </div>
        <!-- Resumen Dinámico Proyectado -->
        <div class="p-3 bg-surface-container rounded-xl flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-primary">calculate</span>
            <span class="font-body-sm text-body-sm text-on-surface font-medium">Resultado Proyectado:</span>
          </div>
          <div class="font-data-tabular text-data-tabular font-bold text-on-surface" id="stock-calc-preview">
            <!-- Computed dynamically -->
          </div>
        </div>
      </section>

      <!-- SECCIÓN 4: Nota u Observación -->
      <section class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-space-sm">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-secondary"></span>
            4. Nota u Observación (Opcional)
          </span>
          <span class="font-label-sm text-label-sm text-secondary" id="char-count">0 / 250</span>
        </div>
        <div class="relative">
          <textarea class="w-full bg-surface-container-low text-on-surface rounded-xl p-3 font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:bg-surface-container-lowest focus:ring-0 shadow-sm transition-all" id="text-notes" maxlength="250" placeholder="Ej. Conteo inicial en estante A, reposición matutina o producto retirado por fallas..." rows="3"></textarea>
        </div>
        <!-- Chips de Motivos Predefinidos -->
        <div class="space-y-1.5 pt-1">
          <p class="font-label-sm text-label-sm text-secondary">Sugerencias rápidas:</p>
          <div class="flex flex-wrap gap-1.5">
            <button class="btn-preset-chip px-2.5 py-1 rounded-full bg-surface-container-low text-secondary hover:text-on-surface hover:bg-surface-container active:scale-95 font-label-sm text-label-sm transition-colors" type="button">
              Despacho cliente
            </button>
            <button class="btn-preset-chip px-2.5 py-1 rounded-full bg-surface-container-low text-secondary hover:text-on-surface hover:bg-surface-container active:scale-95 font-label-sm text-label-sm transition-colors" type="button">
              Conteo matutino
            </button>
            <button class="btn-preset-chip px-2.5 py-1 rounded-full bg-surface-container-low text-secondary hover:text-on-surface hover:bg-surface-container active:scale-95 font-label-sm text-label-sm transition-colors" type="button">
              Ajuste de vitrina
            </button>
            <button class="btn-preset-chip px-2.5 py-1 rounded-full bg-surface-container-low text-secondary hover:text-on-surface hover:bg-surface-container active:scale-95 font-label-sm text-label-sm transition-colors" type="button">
              Producto dañado
            </button>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 5: Acciones Inferiores -->
      <div class="fixed bottom-0 left-0 right-0 p-4 bg-surface-container-lowest/90 backdrop-blur-md shadow-2xl flex items-center justify-between gap-3 max-w-lg mx-auto z-40">
        <a href="/" class="h-12 px-5 rounded-xl bg-surface-container text-on-secondary-container hover:bg-surface-container-high font-label-lg text-label-lg active:scale-95 transition-all flex items-center justify-center">
          Cancelar
        </a>
        <button class="flex-1 h-12 px-6 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 hover:opacity-95 active:scale-95 transition-all shadow-md" id="btn-submit" type="button">
          <span class="material-symbols-outlined text-[20px]">check_circle</span>
          <span>Registrar Movimiento</span>
        </button>
      </div>
    </div>
  </main>

  <script is:inline>
    const STORE_KEY = 'stock_movil_inventory_v1';

    const defaultItems = [
      { id: 'sku-520', sku: 'SKU-520', name: 'Soporte Magnético para Auto', category: 'Auto', stock: 1, minStock: 5, maxStock: 10, location: 'Vitrina A-1', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCoO16TT-tR-wlBrTApCGHxTpxWYKIILFh-fa-B9ONyuxDC7S0ZXI1xdRds3NS2MAjynS8X2uxtjbBTZFQOx3cu80HN_IChP6er-zID8eNdtHMdl2IaINz3QBd6WqP7XAeWK_-CkFA6KuSLUQ3uYW8aLVdzLA0HU-wJ4SV3_opoxIxnm0ropW05_gKwnufdKjkZCa6ege8rRfS1fIRvvjUVG7PXm7gqADoptCJ87melL-SZW9KfqE8rfw' },
      { id: 'sku-092', sku: 'SKU-092', name: 'Funda Silicona Case iPhone 15 Pro', category: 'Fundas', stock: 3, minStock: 5, maxStock: 10, location: 'Vitrina F-2', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww' },
      { id: 'sku-104', sku: 'SKU-104', name: 'Mica Vidrio Templado 9D iPhone', category: 'Micas', stock: 3, minStock: 5, maxStock: 10, location: 'Estante M-3', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDArc9PQMZMX60YZdL2HuhroEsYV6UgzSH87z-kJS4ARnnmSqmNSHgA9qBp7g6F6dHgZFFqTSVgq2gdJp58wHONkBxTxsO8hE0qtwatBHzLpB31H6chYL2O8S5CJSDi-z88o0vFq5sZcG3tsWBWISuppZf-tVqo03v5gno6pOC0TkrrhFGhyhCHAt7jP4NM9ZHobv-4beNobhEKe-UBtNC0__DBtmC90qfTOgVDh-SgPW_fPqxi2Q1q1g' },
      { id: 'sku-319', sku: 'SKU-319', name: 'Adaptador Lightning a Jack 3.5mm', category: 'Audio', stock: 4, minStock: 5, maxStock: 10, location: 'Cajón A-4', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBEddAYibZMjqLmVbQYfK77Qtk_GR18aEIxR3iZD-Z2oh2vBwMBHO4f5rmtUUOpsECq0Ki6-5kKq2rrbOwb5qTeegm3mwiaDth6G9WXs1pYgShhoy9AIo62Yi2tPtSAwuB9NT8Xg1cpDcF-6cJyQ2S_WpLWIWQIu2INbGpBjXUA7YtOlsTuVV3M7ipH2vBUeAEuuoP8SCLpb0_EussBUxFkyspxVV1X9GEiyd9dr9O0HJLNk35vxy8HOA' },
      { id: 'sku-141', sku: 'SKU-141', name: 'Cargador Rápido 30W USB-C GaN', category: 'Cargas', stock: 8, minStock: 5, maxStock: 10, location: 'Estante C-1', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBrfDhd7aPs8GoEZkbA-xzj03A0JGJv23NKGhczYuRs8EJYYf_q4gvPULwdu7W8msYzasXSZ5CRFCaiereQb0MBGmy_2rZyX803yRgihTlaUjdsvBhZ43BV5z9VhWzAtBp5NCT6sMqRZH17UfXJqbpvnnAVKBFI_dqtFRl2c6VUhREY7ilvtDMv5-2DsAZhazqG9qhIVZnFgDAxPizJb5ovXT5omGmRTXTgZYwc5QvkWW6J76B2YiQrvw' }
    ];

    function getStoredInventory() {
      const raw = localStorage.getItem(STORE_KEY);
      if (!raw) return defaultItems;
      try { return JSON.parse(raw); } catch (e) { return defaultItems; }
    }

    function saveInventory(items) {
      localStorage.setItem(STORE_KEY, JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('inventory-updated', { detail: items }));
    }

    let inventory = getStoredInventory();
    let selectedSku = inventory[0]?.sku || 'SKU-092';
    let currentFactor = -1;
    let selectedQty = 1;

    const dropdown = document.getElementById('productSelectDropdown');
    const inputQty = document.getElementById('input-qty');
    const btnInc = document.getElementById('btn-inc');
    const btnDec = document.getElementById('btn-dec');
    const quickAddBtns = document.querySelectorAll('.btn-quick-add');
    const movementCards = document.querySelectorAll('.movement-card');
    const calcPreview = document.getElementById('stock-calc-preview');
    const badgeResumen = document.getElementById('badge-tipo-resumen');
    const notesTextarea = document.getElementById('text-notes');
    const charCounter = document.getElementById('char-count');
    const presetChips = document.querySelectorAll('.btn-preset-chip');
    const btnSubmit = document.getElementById('btn-submit');

    function populateDropdown() {
      if (!dropdown) return;
      dropdown.innerHTML = '';
      inventory.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.sku;
        opt.textContent = `${item.name} (${item.sku}) - ${item.stock} unid.`;
        dropdown.appendChild(opt);
      });
      dropdown.value = selectedSku;
    }

    function updateSelectedCardDisplay() {
      const item = inventory.find(i => i.sku === selectedSku);
      if (!item) return;

      const title = document.getElementById('selectedCardTitle');
      const category = document.getElementById('selectedCardCategory');
      const sku = document.getElementById('selectedCardSku');
      const stock = document.getElementById('selectedCardStock');
      const status = document.getElementById('selectedCardStatus');
      const img = document.getElementById('selectedCardImg');
      const border = document.getElementById('selectedCardBorder');

      if (title) title.textContent = item.name;
      if (category) category.textContent = item.category;
      if (sku) sku.textContent = item.sku;
      if (stock) stock.textContent = `${item.stock} disp.`;
      if (img && item.img) img.src = item.img;

      const isLow = item.stock < (item.minStock || 5);
      if (status) {
        status.textContent = isLow ? 'Stock Crítico' : 'OK';
        status.className = `px-2 py-0.5 rounded-full ${isLow ? 'bg-error-container text-on-error-container' : 'bg-tertiary-fixed text-on-tertiary-fixed'} text-[11px] font-label-sm font-semibold shrink-0`;
      }
      if (border) {
        border.className = `absolute left-0 top-0 bottom-0 w-1 ${isLow ? 'bg-error' : 'bg-tertiary'}`;
      }

      updateStockCalculation();
    }

    function updateStockCalculation() {
      const item = inventory.find(i => i.sku === selectedSku);
      if (!item || !inputQty || !calcPreview) return;

      selectedQty = Math.max(1, parseInt(inputQty.value) || 1);
      inputQty.value = selectedQty;
      const currentStock = item.stock;

      let resultText = '';
      if (currentFactor === -1) {
        const finalStock = currentStock - selectedQty;
        const colorClass = finalStock < 0 ? 'text-error font-extrabold' : 'text-primary font-extrabold';
        resultText = `${currentStock} - ${selectedQty} = <span class="${colorClass} text-headline-sm">${finalStock} unidades</span>`;
      } else if (currentFactor === 1) {
        const finalStock = currentStock + selectedQty;
        resultText = `${currentStock} + ${selectedQty} = <span class="text-tertiary font-extrabold text-headline-sm">${finalStock} unidades</span>`;
      } else {
        resultText = `Fijar stock en: <span class="text-primary font-extrabold text-headline-sm">${selectedQty} unidades</span>`;
      }
      calcPreview.innerHTML = resultText;
    }

    dropdown?.addEventListener('change', (e) => {
      selectedSku = e.target.value;
      updateSelectedCardDisplay();
    });

    btnInc?.addEventListener('click', () => {
      if (inputQty) inputQty.value = parseInt(inputQty.value || 1) + 1;
      updateStockCalculation();
    });

    btnDec?.addEventListener('click', () => {
      if (inputQty) {
        const val = parseInt(inputQty.value || 1);
        if (val > 1) {
          inputQty.value = val - 1;
          updateStockCalculation();
        }
      }
    });

    inputQty?.addEventListener('input', updateStockCalculation);

    quickAddBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const addVal = parseInt(btn.getAttribute('data-val') || '1');
        if (inputQty) inputQty.value = parseInt(inputQty.value || 0) + addVal;
        updateStockCalculation();
      });
    });

    movementCards.forEach(card => {
      card.addEventListener('click', () => {
        movementCards.forEach(c => {
          c.classList.remove('bg-primary-fixed', 'text-on-primary-fixed');
          c.classList.add('bg-surface-container-low', 'text-on-surface');
          const radio = c.querySelector('.radio-indicator');
          radio?.classList.remove('bg-primary', 'text-on-primary');
          radio?.classList.add('bg-surface-container-highest', 'text-transparent');
        });

        card.classList.remove('bg-surface-container-low', 'text-on-surface');
        card.classList.add('bg-primary-fixed', 'text-on-primary-fixed');
        const radio = card.querySelector('.radio-indicator');
        radio?.classList.remove('bg-surface-container-highest', 'text-transparent');
        radio?.classList.add('bg-primary', 'text-on-primary');

        currentFactor = parseInt(card.getAttribute('data-factor') || '-1');
        const type = card.getAttribute('data-type');

        if (badgeResumen) {
          if (type === 'out') {
            badgeResumen.textContent = 'Salida (-)';
            badgeResumen.className = 'text-label-sm font-label-sm text-error bg-error-container px-2 py-0.5 rounded-full';
          } else if (type === 'in') {
            badgeResumen.textContent = 'Entrada (+)';
            badgeResumen.className = 'text-label-sm font-label-sm text-tertiary bg-tertiary-fixed px-2 py-0.5 rounded-full';
          } else {
            badgeResumen.textContent = 'Ajuste (=)';
            badgeResumen.className = 'text-label-sm font-label-sm text-secondary bg-secondary-container px-2 py-0.5 rounded-full';
          }
        }

        updateStockCalculation();
      });
    });

    notesTextarea?.addEventListener('input', () => {
      if (charCounter && notesTextarea) charCounter.textContent = `${notesTextarea.value.length} / 250`;
    });

    presetChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const text = chip.textContent.trim();
        if (notesTextarea) {
          if (notesTextarea.value) {
            notesTextarea.value += `, ${text}`;
          } else {
            notesTextarea.value = text;
          }
          if (charCounter) charCounter.textContent = `${notesTextarea.value.length} / 250`;
        }
      });
    });

    btnSubmit?.addEventListener('click', () => {
      const item = inventory.find(i => i.sku === selectedSku);
      if (!item) return;

      const originalHtml = btnSubmit.innerHTML;
      btnSubmit.innerHTML = `<span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span><span>Guardando...</span>`;
      btnSubmit.setAttribute('disabled', 'true');

      let newStock = item.stock;
      if (currentFactor === -1) {
        newStock = Math.max(0, item.stock - selectedQty);
      } else if (currentFactor === 1) {
        newStock = Math.min(10, item.stock + selectedQty);
      } else {
        newStock = Math.max(0, Math.min(10, selectedQty));
      }

      item.stock = newStock;
      saveInventory(inventory);

      setTimeout(() => {
        btnSubmit.classList.remove('bg-primary');
        btnSubmit.classList.add('bg-tertiary');
        btnSubmit.innerHTML = `<span class="material-symbols-outlined text-[20px]">done_all</span><span>¡Registrado a ${newStock} unid.!</span>`;
        updateSelectedCardDisplay();
        setTimeout(() => {
          btnSubmit.classList.remove('bg-tertiary');
          btnSubmit.classList.add('bg-primary');
          btnSubmit.innerHTML = originalHtml;
          btnSubmit.removeAttribute('disabled');
        }, 1800);
      }, 600);
    });

    populateDropdown();
    updateSelectedCardDisplay();
  </script>
</Layout>
