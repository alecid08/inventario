---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Express - Movimientos de Inventario">
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile">
    <div class="flex flex-col w-full pb-24 space-y-space-md">
      <!-- Header / Barra Superior Contextual -->
      <header class="flex flex-col space-y-space-xs pt-space-xs">
        <div class="flex items-center justify-between">
          <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}`} aria-label="Volver atrás" class="flex items-center justify-center w-10 h-10 rounded-full bg-surface-container-low text-on-surface hover:bg-surface-container transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
          </a>
          <div class="flex items-center space-x-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-label-sm font-label-sm font-semibold border border-surface-container-highest">
            <span class="material-symbols-outlined text-[16px] text-primary">person</span>
            <span id="activeOperatorBadge">Alejandro (Admin)</span>
          </div>
        </div>
        <div class="pt-1">
          <h1 class="font-headline-lg text-headline-lg text-on-surface font-bold">Movimientos de Inventario</h1>
          <p class="font-body-sm text-body-sm text-secondary">
            Función exclusiva: <strong class="text-emerald-700">Agregar (+)</strong> o <strong class="text-rose-700">Rebajar (-)</strong> unidades de productos
          </p>
        </div>
      </header>

      <!-- Feedback Toast -->
      <div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-0 pointer-events-none transition-all duration-200" id="actionToast">
        <span class="material-symbols-outlined text-tertiary-fixed text-[18px]" id="toastIcon">check_circle</span>
        <span id="toastText">Movimiento registrado</span>
      </div>

      <!-- SECCIÓN 1: Selector de Producto (Todos los productos de la BD) -->
      <section class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm border border-surface-container space-y-space-sm">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5 font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
            1. Seleccionar Producto
          </span>
          <span class="text-secondary font-label-sm text-label-sm">Catálogo Completo</span>
        </div>
        
        <!-- Dropdown / Select bar -->
        <div class="relative flex items-center bg-surface-container-low rounded-xl px-3 h-12 shadow-sm focus-within:bg-surface-container-lowest focus-within:ring-2 focus-within:ring-primary transition-all">
          <span class="material-symbols-outlined text-secondary text-[20px] mr-2">inventory_2</span>
          <select class="w-full bg-transparent text-on-surface font-body-md text-body-md focus:outline-none cursor-pointer" id="productSelectDropdown">
            <!-- Cargado con todos los productos registrados en la base de datos -->
          </select>
        </div>

        <!-- Tarjeta de Previsualización de Producto Seleccionado -->
        <div class="relative bg-surface-container-low rounded-xl p-3 flex gap-3 items-center overflow-hidden border border-surface-container/60" id="selectedProductCard">
          <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-tertiary" id="selectedCardBorder"></div>
          <div class="w-16 h-16 rounded-xl bg-surface-container-highest flex items-center justify-center overflow-hidden shrink-0 shadow-inner">
            <img alt="Producto Seleccionado" class="w-full h-full object-cover" id="selectedCardImg" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww"/>
          </div>
          <div class="flex-1 min-w-0 space-y-1">
            <div class="flex items-center justify-between gap-1">
              <span class="font-label-sm text-label-sm text-secondary truncate" id="selectedCardCategory">Categoría</span>
              <span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed text-[11px] font-label-sm font-semibold shrink-0" id="selectedCardStatus">
                OK
              </span>
            </div>
            <p class="font-label-lg text-label-lg text-on-surface truncate font-bold leading-tight" id="selectedCardTitle">Cargando producto...</p>
            <div class="flex items-center justify-between text-sku-code font-sku-code">
              <span class="text-secondary tracking-wider text-[11px]" id="selectedCardSku">SKU-000</span>
              <span class="font-data-tabular text-data-tabular font-bold text-on-surface" id="selectedCardStock">Stock actual: 0</span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 2 & 3: Tipo de Movimiento y Cantidad de Unidades Integrados -->
      <section class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm border border-surface-container space-y-space-sm">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5 font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
            2. Operación y Cantidad de Unidades
          </span>
          <span class="text-label-sm font-label-sm text-error bg-error-container px-2 py-0.5 rounded-full font-semibold" id="badge-tipo-resumen">
            Rebajar (-)
          </span>
        </div>

        <!-- Selector de Tipo: Solo Entrada (+) o Salida (-) -->
        <div class="grid grid-cols-2 gap-2" id="movement-type-group">
          <!-- Opción 1: Rebajar / Salida (-) -->
          <label class="movement-card flex flex-col items-center justify-center p-3 rounded-xl cursor-pointer bg-primary-fixed text-on-primary-fixed shadow-sm border-2 border-primary transition-all text-center" data-factor="-1" data-type="salida">
            <div class="w-10 h-10 rounded-full bg-rose-600 text-white flex items-center justify-center mb-1 shadow-sm">
              <span class="material-symbols-outlined text-[22px]">remove_circle</span>
            </div>
            <span class="font-label-lg text-label-lg font-bold">Rebajar / Salida</span>
            <span class="text-[11px] opacity-80">Venta o retiro (- unid.)</span>
          </label>

          <!-- Opción 2: Agregar / Entrada (+) -->
          <label class="movement-card flex flex-col items-center justify-center p-3 rounded-xl cursor-pointer bg-surface-container-low text-on-surface hover:bg-surface-container border-2 border-transparent transition-all text-center" data-factor="1" data-type="entrada">
            <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center mb-1 shadow-sm">
              <span class="material-symbols-outlined text-[22px]">add_circle</span>
            </div>
            <span class="font-label-lg text-label-lg font-bold">Agregar / Entrada</span>
            <span class="text-[11px] text-secondary">Ingreso de stock (+ unid.)</span>
          </label>
        </div>

        <!-- Stepper Compacto de Unidades -->
        <div class="pt-2">
          <label class="block font-label-sm text-label-sm text-secondary mb-1.5 font-medium">Cantidad a mover:</label>
          <div class="flex items-center justify-between bg-surface-container-low rounded-2xl p-2 shadow-inner">
            <button class="w-12 h-12 rounded-xl bg-surface-container-lowest text-on-surface hover:bg-surface-container-high active:scale-95 flex items-center justify-center transition-all shadow-sm" id="btn-dec" type="button">
              <span class="material-symbols-outlined text-[24px]">remove</span>
            </button>
            <div class="flex flex-col items-center justify-center">
              <input class="w-20 text-center font-display text-headline-lg bg-transparent text-primary font-bold focus:outline-none" id="input-qty" max="10" min="1" type="number" value="1"/>
              <span class="font-label-sm text-label-sm text-secondary -mt-1 font-medium">unidad(es)</span>
            </div>
            <button class="w-12 h-12 rounded-xl bg-primary text-on-primary hover:opacity-90 active:scale-95 flex items-center justify-center transition-all shadow-sm" id="btn-inc" type="button">
              <span class="material-symbols-outlined text-[24px]">add</span>
            </button>
          </div>

          <!-- Botones de incremento rápido compactos -->
          <div class="grid grid-cols-4 gap-2 mt-2">
            <button class="btn-quick-add py-2 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm font-semibold" data-val="1" type="button">+1</button>
            <button class="btn-quick-add py-2 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm font-semibold" data-val="2" type="button">+2</button>
            <button class="btn-quick-add py-2 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm font-semibold" data-val="5" type="button">+5</button>
            <button class="btn-quick-add py-2 rounded-lg bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container active:scale-95 transition-all shadow-sm font-semibold" data-val="10" type="button">+10</button>
          </div>
        </div>

        <!-- Resultado Final Directo (Sin mostrar la fórmula intermedia de cálculo) -->
        <div class="p-3 bg-surface-container rounded-xl flex items-center justify-between mt-2 border border-surface-container-highest">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-primary">analytics</span>
            <span class="font-body-sm text-body-sm text-on-surface font-semibold">Stock Final Proyectado:</span>
          </div>
          <div class="font-headline-sm text-headline-sm font-bold" id="stock-calc-preview">
            <!-- Muestra solo el resultado final directo -->
          </div>
        </div>
      </section>

      <!-- SECCIÓN 3: Nota u Observación (Opcional - puede ir en blanco) -->
      <section class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm border border-surface-container space-y-space-sm">
        <div class="flex items-center justify-between">
          <span class="font-label-md text-label-md text-on-surface flex items-center gap-1.5 font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
            3. Nota u Observación <span class="text-secondary font-normal text-xs">(Opcional, puede quedar en blanco)</span>
          </span>
          <span class="font-label-sm text-label-sm text-secondary" id="char-count">0 / 250</span>
        </div>
        <div class="relative">
          <textarea class="w-full bg-surface-container-low text-on-surface rounded-xl p-3 font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary shadow-sm transition-all" id="text-notes" maxlength="250" placeholder="Opcional: motivo del movimiento, cliente, venta en mostrador..." rows="2"></textarea>
        </div>
      </section>

      <!-- BOTÓN ESENCIAL Y DESTACADO PARA CONFIRMAR Y GUARDAR -->
      <div class="pt-1">
        <button class="w-full h-14 rounded-2xl bg-primary text-on-primary font-headline-sm text-headline-sm font-bold flex items-center justify-center gap-2.5 shadow-lg shadow-primary/25 hover:opacity-95 active:scale-[0.99] transition-all cursor-pointer" id="btn-submit" type="button">
          <span class="material-symbols-outlined text-[26px]">save</span>
          <span>Confirmar y Guardar Movimiento</span>
        </button>
      </div>

      <!-- SECCIÓN 4: Historial de Movimientos de Hoy -->
      <section class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm border border-surface-container space-y-space-sm">
        <div class="flex items-center justify-between border-b border-surface-container pb-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">history</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Movimientos de Hoy</h3>
          </div>
          <span class="font-label-sm text-label-sm text-secondary">Registro del Turno</span>
        </div>
        <div class="flex flex-col space-y-2 mt-2" id="movementsHistoryContainer">
          <!-- Renderizado dinámicamente -->
        </div>
      </section>
    </div>
  </main>

  <script>
    import { getStoredInventory, recordMovement, revertirMovimiento, getStoredMovements, isSameCalendarDay, getCurrentOperator } from '../utils/inventoryStore.js';
    import type { Product, Movement } from '../types/inventory';

    let inventory: Product[] = getStoredInventory(true);
    let selectedSku = inventory[0]?.sku || '';
    let currentFactor = -1; // -1 = Salida/Rebajar, 1 = Entrada/Agregar
    let selectedQty = 1;

    const dropdown = document.getElementById('productSelectDropdown') as HTMLSelectElement | null;
    const inputQty = document.getElementById('input-qty') as HTMLInputElement | null;
    const btnInc = document.getElementById('btn-inc');
    const btnDec = document.getElementById('btn-dec');
    const quickAddBtns = document.querySelectorAll('.btn-quick-add');
    const movementCards = document.querySelectorAll('.movement-card');
    const calcPreview = document.getElementById('stock-calc-preview');
    const badgeResumen = document.getElementById('badge-tipo-resumen');
    const notesTextarea = document.getElementById('text-notes') as HTMLTextAreaElement | null;
    const charCounter = document.getElementById('char-count');
    const btnSubmit = document.getElementById('btn-submit');
    const toast = document.getElementById('actionToast');
    const toastText = document.getElementById('toastText');
    const toastIcon = document.getElementById('toastIcon');
    const operatorBadge = document.getElementById('activeOperatorBadge');

    if (operatorBadge) {
      operatorBadge.textContent = getCurrentOperator();
    }

    function showToast(msg: string, isError = false) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      if (toastIcon) toastIcon.textContent = isError ? 'error' : 'check_circle';
      if (isError) {
        toast.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-error-container text-on-error-container px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-100 transition-all duration-200';
      } else {
        toast.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-100 transition-all duration-200';
      }
      setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 3200);
    }

    // Carga TODOS los productos que han sido agregados a la base de datos
    function populateDropdown() {
      if (!dropdown) return;
      dropdown.innerHTML = '';
      inventory = getStoredInventory(true); // Incluye todos los registrados

      if (inventory.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = 'No hay productos registrados en el inventario';
        dropdown.appendChild(opt);
        return;
      }

      inventory.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.sku;
        const statusText = item.activo === false ? ' [Inactivo]' : '';
        opt.textContent = `${item.name} (${item.sku}) - Stock actual: ${item.stock}${statusText}`;
        dropdown.appendChild(opt);
      });

      if (!selectedSku || !inventory.some(i => i.sku === selectedSku)) {
        selectedSku = inventory[0].sku;
      }
      dropdown.value = selectedSku;
    }

    function updateSelectedCardDisplay() {
      inventory = getStoredInventory(true);
      const item = inventory.find(i => i.sku === selectedSku);
      if (!item) return;

      const title = document.getElementById('selectedCardTitle');
      const category = document.getElementById('selectedCardCategory');
      const sku = document.getElementById('selectedCardSku');
      const stock = document.getElementById('selectedCardStock');
      const status = document.getElementById('selectedCardStatus');
      const img = document.getElementById('selectedCardImg') as HTMLImageElement | null;
      const border = document.getElementById('selectedCardBorder');

      if (title) title.textContent = item.name;
      if (category) category.textContent = item.category;
      if (sku) sku.textContent = item.sku;
      if (stock) stock.textContent = `Stock actual: ${item.stock} / ${item.maxStock || 10} disp.`;
      if (img && item.img) img.src = item.img;

      const isLow = item.stock < (item.minStock || 5);
      if (status) {
        status.textContent = isLow ? 'Stock Crítico' : 'OK';
        status.className = `px-2 py-0.5 rounded-full ${isLow ? 'bg-error-container text-on-error-container' : 'bg-emerald-100 text-emerald-800'} text-[11px] font-label-sm font-semibold shrink-0`;
      }
      if (border) {
        border.className = `absolute left-0 top-0 bottom-0 w-1.5 ${isLow ? 'bg-error' : 'bg-tertiary'}`;
      }

      updateStockCalculation();
      renderMovementsHistory();
    }

    // Muestra ÚNICAMENTE el resultado final proyectado (sin fórmulas intermedias)
    function updateStockCalculation() {
      const item = inventory.find(i => i.sku === selectedSku);
      if (!item || !inputQty || !calcPreview) return;

      selectedQty = Math.max(1, parseInt(inputQty.value) || 1);
      inputQty.value = selectedQty.toString();
      const currentStock = item.stock;
      const maxAllowed = item.maxStock || 10;

      if (currentFactor === -1) {
        // Rebajar / Salida
        const finalStock = currentStock - selectedQty;
        if (finalStock < 0) {
          calcPreview.innerHTML = `<span class="text-error font-extrabold">${finalStock} unid. (¡Insuficiente!)</span>`;
        } else {
          calcPreview.innerHTML = `<span class="text-primary font-extrabold">${finalStock} unid.</span>`;
        }
      } else {
        // Agregar / Entrada
        const finalStock = currentStock + selectedQty;
        if (finalStock > maxAllowed) {
          calcPreview.innerHTML = `<span class="text-error font-extrabold">${finalStock} unid. (Excede tope ${maxAllowed})</span>`;
        } else {
          calcPreview.innerHTML = `<span class="text-emerald-700 font-extrabold">${finalStock} unid.</span>`;
        }
      }
    }

    // Listener para cambiar de producto
    dropdown?.addEventListener('change', (e) => {
      selectedSku = (e.target as HTMLSelectElement).value;
      updateSelectedCardDisplay();
    });

    // Control de unidades (+ y -)
    btnInc?.addEventListener('click', () => {
      if (!inputQty) return;
      let val = parseInt(inputQty.value) || 1;
      if (val < 10) {
        inputQty.value = (val + 1).toString();
        updateStockCalculation();
      }
    });

    btnDec?.addEventListener('click', () => {
      if (!inputQty) return;
      let val = parseInt(inputQty.value) || 1;
      if (val > 1) {
        inputQty.value = (val - 1).toString();
        updateStockCalculation();
      }
    });

    inputQty?.addEventListener('input', updateStockCalculation);

    quickAddBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (!inputQty) return;
        const add = parseInt(btn.getAttribute('data-val') || '1', 10);
        inputQty.value = Math.min(10, Math.max(1, add)).toString();
        updateStockCalculation();
      });
    });

    // Selección de Tipo de Movimiento (Solo Salida o Entrada)
    movementCards.forEach(card => {
      card.addEventListener('click', () => {
        movementCards.forEach(c => {
          c.className = 'movement-card flex flex-col items-center justify-center p-3 rounded-xl cursor-pointer bg-surface-container-low text-on-surface hover:bg-surface-container border-2 border-transparent transition-all text-center';
        });

        card.className = 'movement-card flex flex-col items-center justify-center p-3 rounded-xl cursor-pointer bg-primary-fixed text-on-primary-fixed shadow-sm border-2 border-primary transition-all text-center';

        const factor = parseInt(card.getAttribute('data-factor') || '-1', 10);
        currentFactor = factor;

        if (badgeResumen) {
          if (currentFactor === -1) {
            badgeResumen.textContent = 'Rebajar (-)';
            badgeResumen.className = 'text-label-sm font-label-sm text-error bg-error-container px-2 py-0.5 rounded-full font-semibold';
          } else {
            badgeResumen.textContent = 'Agregar (+)';
            badgeResumen.className = 'text-label-sm font-label-sm text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full font-semibold';
          }
        }

        updateStockCalculation();
      });
    });

    // Contador de caracteres de notas (Permite guardar en blanco)
    notesTextarea?.addEventListener('input', () => {
      if (charCounter && notesTextarea) {
        charCounter.textContent = `${notesTextarea.value.length} / 250`;
      }
    });

    // Guardar Movimiento al presionar el Botón Esencial
    btnSubmit?.addEventListener('click', () => {
      const item = inventory.find(i => i.sku === selectedSku);
      if (!item) {
        showToast('Por favor selecciona un producto válido.', true);
        return;
      }

      const qty = parseInt(inputQty?.value || '1', 10);
      if (isNaN(qty) || qty <= 0) {
        showToast('Ingresa una cantidad válida mayor a 0.', true);
        return;
      }

      const tipoMov = currentFactor === -1 ? 'salida' : 'entrada';
      const nota = notesTextarea?.value.trim() || '';

      // Validación preventiva de límites
      if (tipoMov === 'salida' && item.stock - qty < 0) {
        showToast(`Stock insuficiente. Solo hay ${item.stock} unidades disponibles.`, true);
        return;
      }

      if (tipoMov === 'entrada' && item.stock + qty > (item.maxStock || 10)) {
        showToast(`No se puede superar el tope máximo de ${item.maxStock || 10} unidades.`, true);
        return;
      }

      try {
        const activeOp = getCurrentOperator();
        const newMov = recordMovement({
          sku: item.sku,
          tipo: tipoMov,
          cantidad: qty,
          nota: nota,
          operador: activeOp
        });

        // Limpiar nota y restablecer cantidad
        if (notesTextarea) notesTextarea.value = '';
        if (charCounter) charCounter.textContent = '0 / 250';
        if (inputQty) inputQty.value = '1';

        // Actualizar vistas
        populateDropdown();
        updateSelectedCardDisplay();
        showToast(`¡Movimiento guardado exitosamente! Nuevo stock: ${newMov.stockResultante} unid.`);
      } catch (err: any) {
        showToast(err.message || 'Error al guardar el movimiento.', true);
      }
    });

    // Renderizar Historial de Hoy
    function renderMovementsHistory() {
      const container = document.getElementById('movementsHistoryContainer');
      if (!container) return;
      container.innerHTML = '';

      const movements: Movement[] = getStoredMovements();
      const now = new Date();
      const todayMovements = movements.filter(m => isSameCalendarDay(m.fechaHora, now));

      if (todayMovements.length === 0) {
        container.innerHTML = `
          <div class="py-6 text-center text-secondary text-body-sm flex flex-col items-center">
            <span class="material-symbols-outlined text-[32px] mb-1 opacity-40">receipt_long</span>
            <span>No se han registrado movimientos hoy</span>
          </div>
        `;
        return;
      }

      todayMovements.forEach(m => {
        const isEntry = m.tipo === 'entrada' || m.tipo === 'reposicion';
        const isReversion = m.tipo === 'reversion';
        const sign = isEntry ? '+' : (isReversion ? '↺' : '-');
        const colorClass = isEntry ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : (isReversion ? 'text-purple-700 bg-purple-50 border-purple-200' : 'text-rose-700 bg-rose-50 border-rose-200');

        const timeStr = new Date(m.fechaHora).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const div = document.createElement('div');
        div.className = 'p-3 rounded-xl bg-surface-container-low border border-surface-container flex items-center justify-between gap-3 shadow-xs';
        div.innerHTML = `
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold text-sm border ${colorClass} shrink-0">
              ${sign}
            </span>
            <div class="min-w-0">
              <p class="font-label-md text-label-md text-on-surface font-bold truncate">${m.sku}</p>
              <p class="text-[11px] text-secondary truncate">${timeStr} · Resultante: ${m.stockResultante} unid. ${m.nota ? '· ' + m.nota : ''}</p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="font-data-tabular font-bold ${isEntry ? 'text-emerald-700' : 'text-rose-700'} text-sm">${sign}${m.cantidad}</span>
            ${!m.revertido && !isReversion ? `
              <button class="btn-revert px-2 py-1 rounded-lg bg-surface-container text-[11px] font-semibold text-secondary hover:text-error hover:bg-error-container transition-colors" data-id="${m.id}" title="Revertir este movimiento">
                Revertir
              </button>
            ` : (m.revertido ? '<span class="text-[10px] text-outline font-semibold">Revertido</span>' : '')}
          </div>
        `;
        container.appendChild(div);
      });

      // Listeners de reversión
      container.querySelectorAll('.btn-revert').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id) return;
          if (confirm('¿Confirmas revertir este movimiento? El stock se reajustará automáticamente.')) {
            try {
              revertirMovimiento(id);
              populateDropdown();
              updateSelectedCardDisplay();
              showToast('Movimiento revertido exitosamente.');
            } catch (err: any) {
              showToast(err.message, true);
            }
          }
        });
      });
    }

    // Inicialización
    populateDropdown();
    updateSelectedCardDisplay();

    window.addEventListener('inventory-updated', () => {
      populateDropdown();
      updateSelectedCardDisplay();
    });

    window.addEventListener('movements-updated', () => {
      renderMovementsHistory();
    });
  </script>
</Layout>
