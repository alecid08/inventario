---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Express - Redireccionando..." showNav={false}>
  <main class="flex-1 flex flex-col items-center justify-center p-6 text-center">
    <div class="w-16 h-16 rounded-full bg-primary-container/20 text-primary flex items-center justify-center mb-4 animate-spin">
      <span class="material-symbols-outlined text-3xl">sync</span>
    </div>
    <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Cargando sección...</h2>
    <p class="font-body-sm text-body-sm text-on-surface-variant max-w-xs">
      Redireccionando a la vista correcta en Tu Cell Express...
    </p>
  </main>

  <script is:inline>
    // GitHub Pages SPA / 404 fallback script to fix missing trailing slash or direct path issues
    (function() {
      const path = window.location.pathname;
      const base = '/inventario/';
      if (path.startsWith(base) && !path.endsWith('/')) {
        window.location.replace(path + '/' + window.location.search + window.location.hash);
      } else if (!path.startsWith(base)) {
        window.location.replace(base);
      }
    })();
  </script>
</Layout>
