---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Expres - Acceso de Personal" showNav={false}>
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile">
    <div class="flex flex-col w-full max-w-md mx-auto py-space-xl px-space-xs">
      <!-- Brand & Store Identity Header -->
      <header class="flex flex-col items-center text-center mb-space-2xl">
        <!-- Branch Chip -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 mb-space-lg rounded-full bg-surface-container text-on-surface-variant text-label-sm font-label-sm">
          <span class="material-symbols-outlined text-primary text-[16px]">storefront</span>
          <span>Tienda Tu Cell Expres</span>
          <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
          <span class="text-tertiary text-label-sm font-label-sm">En línea</span>
        </div>
        <!-- App Identity -->
        <div class="relative mb-space-md">
          <div class="w-16 h-16 rounded-xl bg-primary-container text-on-primary shadow-sm flex items-center justify-center p-2.5 font-bold text-2xl">
            TC
          </div>
          <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-tertiary flex items-center justify-center text-on-tertiary shadow-sm">
            <span class="material-symbols-outlined text-[12px]">inventory_2</span>
          </div>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface mb-1">Tu Cell Expres</h1>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-[280px]">
          Sistema de Control de Inventario y Auditoría de Piso
        </p>
      </header>

      <!-- Authentication Form Section -->
      <section class="w-full bg-surface-container-lowest p-space-xl rounded-2xl shadow-sm border border-outline-variant/30">
        <form class="flex flex-col gap-space-lg" id="loginForm">
          <!-- Form Header -->
          <div class="flex items-center justify-between pb-space-xs border-b border-surface-container">
            <span class="font-label-md text-label-md text-on-surface">Ingreso de Operador</span>
            <span class="font-sku-code text-sku-code text-on-surface-variant uppercase text-[11px]">ID-POS-01</span>
          </div>

          <!-- Pin / Code Input -->
          <div class="flex flex-col gap-space-xs">
            <label class="font-label-sm text-label-sm text-on-surface flex items-center justify-between" for="operatorPin">
              <span>PIN de Acceso o Código de Personal</span>
              <span class="text-secondary text-[11px]">4 dígitos</span>
            </label>
            <div class="relative flex items-center">
              <span class="material-symbols-outlined absolute left-3.5 text-secondary text-[20px] pointer-events-none">lock</span>
              <input autocomplete="current-password" class="w-full h-touch-min pl-11 pr-12 rounded-xl bg-surface-container-low text-on-surface font-headline-sm text-headline-sm tracking-widest placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all" id="operatorPin" maxlength="6" placeholder="••••" required type="password"/>
              <button aria-label="Mostrar u ocultar PIN" class="absolute right-1 w-11 h-11 flex items-center justify-center text-secondary hover:text-on-surface transition-colors" id="btnTogglePin" type="button">
                <span class="material-symbols-outlined text-[20px]" id="pinEyeIcon">visibility</span>
              </button>
            </div>
            <p class="hidden font-body-sm text-body-sm text-error mt-1 flex items-center gap-1" id="loginErrorMsg">
              <span class="material-symbols-outlined text-[16px]">error</span>
              <span>PIN no reconocido. Intente nuevamente.</span>
            </p>
          </div>

          <!-- Shift & Role Select -->
          <div class="flex flex-col gap-space-xs">
            <label class="font-label-sm text-label-sm text-on-surface" for="shiftRole">Turno de Atención</label>
            <div class="relative flex items-center bg-surface-container-low rounded-xl px-3 h-touch-min">
              <span class="material-symbols-outlined text-secondary text-[20px] mr-2">schedule</span>
              <select class="w-full bg-transparent text-on-surface font-body-md text-body-md focus:outline-none cursor-pointer" id="shiftRole">
                <option value="mañana">Turno Mañana (09:00 - 14:00)</option>
                <option value="tarde">Turno Tarde (14:00 - 19:00)</option>
                <option value="auditoria">Auditoría / Conteo de Cierre</option>
              </select>
            </div>
          </div>

          <!-- Submit Button -->
          <button class="w-full h-14 mt-space-xs rounded-xl bg-primary text-on-primary font-headline-sm text-headline-sm font-semibold shadow-md hover:bg-primary/95 active:scale-[0.99] transition-all flex items-center justify-center gap-space-xs group" id="btnLoginSubmit" type="submit">
            <span>Iniciar Sesión de Conteo</span>
            <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </button>
        </form>
      </section>

      <!-- Quick Demo Credentials Hint -->
      <footer class="mt-space-xl text-center flex flex-col items-center gap-space-xs">
        <div class="p-3 bg-surface-container-low rounded-xl text-body-sm font-body-sm text-on-surface-variant max-w-xs">
          <p class="font-label-sm text-label-sm text-on-surface font-semibold mb-0.5">Acceso Demostración:</p>
          <p>Cualquier PIN de 4 dígitos (Ej. <strong class="text-primary">1234</strong>)</p>
        </div>
      </footer>
    </div>
  </main>

  <script is:inline>
    const pinInput = document.getElementById('operatorPin');
    const togglePinBtn = document.getElementById('btnTogglePin');
    const eyeIcon = document.getElementById('pinEyeIcon');
    const loginForm = document.getElementById('loginForm');
    const errorMsg = document.getElementById('loginErrorMsg');

    togglePinBtn?.addEventListener('click', () => {
      if (!pinInput || !eyeIcon) return;
      const isPassword = pinInput.type === 'password';
      pinInput.type = isPassword ? 'text' : 'password';
      eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
    });

    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const pin = pinInput?.value || '';

      if (pin.length >= 4) {
        if (errorMsg) errorMsg.classList.add('hidden');
        window.location.href = '/';
      } else {
        if (errorMsg) errorMsg.classList.remove('hidden');
      }
    });
  </script>
</Layout>
