---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Express - Acceso Seguro" showNav={false}>
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile justify-center min-h-screen py-8 pt-safe pb-safe">
    <div class="flex flex-col w-full max-w-md mx-auto">
      <!-- Brand & Store Identity Header -->
      <header class="flex flex-col items-center text-center mb-6">
        <!-- Branch Chip -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 mb-3 rounded-full bg-surface-container text-on-surface-variant text-label-sm font-label-sm shadow-2xs">
          <span class="material-symbols-outlined text-primary text-[16px]">storefront</span>
          <span class="font-semibold">Tu Cell Express</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-emerald-700 font-bold text-label-sm">Servidor Activo</span>
        </div>
        
        <!-- Official Logo Tu Cell Express -->
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-700 via-primary to-blue-500 text-white flex items-center justify-center shadow-lg shadow-primary/25 p-3.5 mb-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
            <rect width="14" height="20" x="5" y="2" rx="3" ry="3"/>
            <path d="M12 18h.01"/>
            <path d="M9 6h6"/>
          </svg>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface font-black tracking-tight">Acceso al Sistema</h1>
        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[320px] mt-1 font-medium">
          Control de Inventario y Operaciones · Exclusivo Personal Autorizado
        </p>
      </header>

      <!-- Security Notice Banner -->
      <div class="mb-4 bg-blue-50/80 border border-blue-200/80 rounded-2xl p-3.5 flex items-start gap-2.5 shadow-xs">
        <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">verified_user</span>
        <div class="text-[11px] text-blue-900 leading-snug">
          <p class="font-bold">Acceso Estrictamente Restringido:</p>
          <p class="text-blue-800 mt-0.5">
            Solo el <strong>Dueño</strong> y el <strong>Administrador (Alejandro)</strong> cuentan con autorización para ver y modificar el inventario.
          </p>
        </div>
      </div>

      <!-- Authentication Container Section -->
      <section class="w-full bg-surface-container-lowest p-5 sm:p-6 rounded-3xl shadow-sm border border-surface-container relative overflow-hidden">
        <!-- Tabs Selector: Iniciar Sesión vs Crear / Registrar Contraseña -->
        <div class="flex items-center p-1 bg-surface-container rounded-2xl mb-5">
          <button 
            id="tabLogin" 
            type="button" 
            class="flex-1 py-2 rounded-xl text-xs font-bold transition-all text-on-surface bg-surface-container-lowest shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span class="material-symbols-outlined text-[16px]">login</span>
            <span>Iniciar Sesión</span>
          </button>
          <button 
            id="tabRegister" 
            type="button" 
            class="flex-1 py-2 rounded-xl text-xs font-semibold text-secondary hover:text-on-surface transition-all flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span class="material-symbols-outlined text-[16px]">how_to_reg</span>
            <span>Registrar Acceso</span>
          </button>
        </div>

        <!-- Quick Credentials Switcher (Acceso Rápido) -->
        <div class="mb-4">
          <label class="block font-label-sm text-label-sm text-secondary font-semibold mb-1.5">
            Selección Rápida de Cuenta:
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              class="btn-quick-user flex items-center gap-2 p-2.5 rounded-xl border border-surface-container bg-surface-container-low hover:bg-surface-container hover:border-primary/50 transition-all text-left group cursor-pointer"
              data-email="admin@tucellexpress.com"
              data-name="Alejandro (Admin)"
            >
              <div class="w-7 h-7 rounded-lg bg-blue-100 text-primary flex items-center justify-center font-bold text-xs shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                A
              </div>
              <div class="flex flex-col min-w-0">
                <span class="text-xs font-bold text-on-surface truncate">Alejandro</span>
                <span class="text-[10px] text-secondary font-medium truncate">Administrador</span>
              </div>
            </button>

            <button 
              type="button" 
              class="btn-quick-user flex items-center gap-2 p-2.5 rounded-xl border border-surface-container bg-surface-container-low hover:bg-surface-container hover:border-primary/50 transition-all text-left group cursor-pointer"
              data-email="dueno@tucellexpress.com"
              data-name="Dueño (Propietario)"
            >
              <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-xs shrink-0 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                D
              </div>
              <div class="flex flex-col min-w-0">
                <span class="text-xs font-bold text-on-surface truncate">El Dueño</span>
                <span class="text-[10px] text-secondary font-medium truncate">Propietario</span>
              </div>
            </button>
          </div>
        </div>

        <form class="flex flex-col gap-4" id="authForm">
          <!-- Email Input -->
          <div class="flex flex-col gap-1">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="userEmail">
              Correo Electrónico Autorizado
            </label>
            <div class="relative flex items-center">
              <span class="material-symbols-outlined absolute left-3.5 text-secondary text-[20px] pointer-events-none">mail</span>
              <input 
                id="userEmail" 
                type="email" 
                required 
                placeholder="ej: admin@tucellexpress.com" 
                class="w-full h-12 pl-11 pr-4 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm border border-surface-container focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all font-medium"
              />
            </div>
          </div>

          <!-- Password Input -->
          <div class="flex flex-col gap-1">
            <div class="flex items-center justify-between">
              <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="userPassword">
                Contraseña de Seguridad
              </label>
              <span class="text-[11px] text-secondary" id="passwordHint">Mínimo 6 caracteres</span>
            </div>
            <div class="relative flex items-center">
              <span class="material-symbols-outlined absolute left-3.5 text-secondary text-[20px] pointer-events-none">lock</span>
              <input 
                id="userPassword" 
                type="password" 
                required 
                minlength="6"
                placeholder="••••••••" 
                class="w-full h-12 pl-11 pr-12 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm border border-surface-container focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all font-medium tracking-wide"
              />
              <button 
                id="btnTogglePassword" 
                type="button" 
                aria-label="Mostrar u ocultar contraseña"
                class="absolute right-1 w-10 h-10 flex items-center justify-center text-secondary hover:text-on-surface transition-colors cursor-pointer"
              >
                <span class="material-symbols-outlined text-[20px]" id="passwordEyeIcon">visibility</span>
              </button>
            </div>
          </div>

          <!-- Inline Error Message Banner -->
          <div class="hidden bg-error-container/80 border border-error/30 text-on-error-container p-3 rounded-xl flex items-start gap-2 text-xs font-semibold" id="authErrorBanner">
            <span class="material-symbols-outlined text-[18px] text-error shrink-0 mt-0.5">error</span>
            <span id="authErrorText" class="leading-snug">Error de autenticación</span>
          </div>

          <!-- Helper Explanatory Text for Register Mode -->
          <div class="hidden text-[11px] text-secondary bg-surface-container-low p-2.5 rounded-xl border border-surface-container leading-relaxed" id="registerHelpBox">
            <p>
              💡 <strong>Primera vez:</strong> Si aún no has creado tu contraseña en Firebase, escribe tu correo autorizado arriba y la contraseña que deseas asignar. Quedará registrada inmediatamente para tus próximos inicios de sesión.
            </p>
          </div>

          <!-- Submit Button -->
          <button 
            id="btnAuthSubmit" 
            type="submit" 
            class="w-full h-12 mt-2 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md shadow-primary/25 hover:opacity-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:pointer-events-none"
          >
            <span id="btnAuthIcon" class="material-symbols-outlined text-[20px]">lock_open</span>
            <span id="btnAuthText">Entrar al Inventario</span>
          </button>
        </form>
      </section>

      <!-- Security Guarantee Footer -->
      <footer class="mt-6 text-center flex flex-col items-center gap-1">
        <div class="flex items-center gap-1.5 text-secondary text-xs font-medium">
          <span class="material-symbols-outlined text-[16px] text-emerald-600">shield</span>
          <span>Autenticación Cifrada · Firebase Cloud Security</span>
        </div>
        <p class="text-[11px] text-secondary/70">
          Cualquier intento de acceso por cuentas no autorizadas queda registrado y bloqueado.
        </p>
      </footer>
    </div>

    <!-- Success Feedback Toast -->
    <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-emerald-800 text-white px-5 py-3 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2.5 opacity-0 pointer-events-none transition-all duration-300" id="loginSuccessToast">
      <span class="material-symbols-outlined text-[20px] text-emerald-300">check_circle</span>
      <span id="loginSuccessText">¡Sesión iniciada exitosamente!</span>
    </div>
  </main>

  <script>
    import { loginWithEmail, registerAuthorizedUser, isUserAuthorized } from '../utils/authStore.js';
    import { setCurrentOperator } from '../utils/inventoryStore.js';

    let currentMode: 'login' | 'register' = 'login';

    const tabLogin = document.getElementById('tabLogin');
    const tabRegister = document.getElementById('tabRegister');
    const authForm = document.getElementById('authForm') as HTMLFormElement | null;
    const emailInput = document.getElementById('userEmail') as HTMLInputElement | null;
    const passwordInput = document.getElementById('userPassword') as HTMLInputElement | null;
    const togglePasswordBtn = document.getElementById('btnTogglePassword');
    const eyeIcon = document.getElementById('passwordEyeIcon');
    const errorBanner = document.getElementById('authErrorBanner');
    const errorText = document.getElementById('authErrorText');
    const registerHelpBox = document.getElementById('registerHelpBox');
    const btnSubmit = document.getElementById('btnAuthSubmit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btnAuthText');
    const btnIcon = document.getElementById('btnAuthIcon');
    const toast = document.getElementById('loginSuccessToast');
    const toastText = document.getElementById('loginSuccessText');

    // Preset selector buttons
    document.querySelectorAll('.btn-quick-user').forEach(btn => {
      btn.addEventListener('click', () => {
        const email = btn.getAttribute('data-email');
        if (email && emailInput) {
          emailInput.value = email;
          hideError();
          passwordInput?.focus();
        }
      });
    });

    // Toggle Tab Modes
    function setMode(mode: 'login' | 'register') {
      currentMode = mode;
      hideError();
      if (mode === 'login') {
        tabLogin?.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-xs');
        tabLogin?.classList.remove('text-secondary');
        tabRegister?.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-xs');
        tabRegister?.classList.add('text-secondary');

        registerHelpBox?.classList.add('hidden');
        if (btnText) btnText.textContent = 'Entrar al Inventario';
        if (btnIcon) btnIcon.textContent = 'lock_open';
      } else {
        tabRegister?.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-xs');
        tabRegister?.classList.remove('text-secondary');
        tabLogin?.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-xs');
        tabLogin?.classList.add('text-secondary');

        registerHelpBox?.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Crear Contraseña y Registrar';
        if (btnIcon) btnIcon.textContent = 'how_to_reg';
      }
    }

    tabLogin?.addEventListener('click', () => setMode('login'));
    tabRegister?.addEventListener('click', () => setMode('register'));

    // Toggle Password Visibility
    togglePasswordBtn?.addEventListener('click', () => {
      if (!passwordInput || !eyeIcon) return;
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
    });

    function showError(msg: string) {
      if (!errorBanner || !errorText) return;
      errorText.textContent = msg;
      errorBanner.classList.remove('hidden');
    }

    function hideError() {
      errorBanner?.classList.add('hidden');
    }

    function showToast(msg: string) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
    }

    // Set Loading State
    function setLoading(isLoading: boolean) {
      if (!btnSubmit) return;
      btnSubmit.disabled = isLoading;
      if (isLoading) {
        if (btnIcon) {
          btnIcon.textContent = 'sync';
          btnIcon.classList.add('animate-spin');
        }
        if (btnText) btnText.textContent = 'Comprobando credenciales...';
      } else {
        if (btnIcon) {
          btnIcon.classList.remove('animate-spin');
          btnIcon.textContent = currentMode === 'login' ? 'lock_open' : 'how_to_reg';
        }
        if (btnText) {
          btnText.textContent = currentMode === 'login' ? 'Entrar al Inventario' : 'Crear Contraseña y Registrar';
        }
      }
    }

    // Auth Submission
    authForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const email = emailInput?.value.trim().toLowerCase() || '';
      const password = passwordInput?.value || '';

      if (!email || !password) {
        showError('Por favor completa todos los campos.');
        return;
      }

      // Verificación previa de Lista Blanca en el cliente
      if (!isUserAuthorized(email)) {
        showError('Acceso Denegado: Este correo no está autorizado. Solo el Dueño y el Administrador pueden ingresar al sistema.');
        return;
      }

      setLoading(true);

      try {
        if (currentMode === 'login') {
          await loginWithEmail(email, password);
        } else {
          await registerAuthorizedUser(email, password);
        }

        const isOwner = email.includes('dueno');
        const roleLabel = isOwner ? 'Dueño (Propietario)' : 'Alejandro (Admin)';
        setCurrentOperator(roleLabel);

        showToast(`¡Bienvenido, ${roleLabel}! Cargando inventario...`);

        setTimeout(() => {
          const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
          window.location.replace(baseUrl);
        }, 800);
      } catch (err: any) {
        showError(err.message || 'Error al procesar la autenticación.');
        setLoading(false);
      }
    });
  </script>
</Layout>
