---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Express - Editar Accesorio">
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile">
    <div class="flex flex-col w-full pb-28 space-y-space-md max-w-xl mx-auto">
      <!-- Barra de Encabezado Superior -->
      <div class="flex items-center justify-between py-space-xs bg-surface pt-2">
        <div class="flex items-center space-x-space-sm">
          <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}`} aria-label="Volver" class="w-10 h-10 flex items-center justify-center rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high active:scale-95 transition-all shadow-xs">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
          </a>
          <div>
            <div class="flex items-center space-x-space-2xs">
              <h1 class="font-headline-sm text-headline-sm text-on-surface font-bold">Editar Accesorio</h1>
              <span class="px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-sku-code text-sku-code font-bold text-[11px]" id="headerSkuBadge">SKU-000</span>
            </div>
            <p class="font-body-sm text-body-sm text-secondary">Ficha técnica y detalles del accesorio</p>
          </div>
        </div>
        <div class="flex items-center space-x-space-xs">
          <button class="px-3 py-1.5 rounded-xl bg-error-container text-on-error-container font-label-sm text-label-sm flex items-center gap-1.5 hover:brightness-95 active:scale-95 transition-all cursor-pointer font-bold shadow-xs" id="deactivateProductBtn" type="button">
            <span class="material-symbols-outlined text-[16px]" id="deactivateIcon">visibility_off</span>
            <span id="deactivateText">Desactivar</span>
          </button>
        </div>
      </div>

      <!-- Formulario Estructurado -->
      <form class="space-y-space-md" id="productForm">
        <!-- 1. Sección de Imagen de Producto -->
        <div class="p-space-md rounded-2xl bg-surface-container-lowest shadow-sm border border-surface-container space-y-space-sm">
          <div class="flex items-center justify-between">
            <label class="font-label-md text-label-md text-on-surface font-bold flex items-center gap-1.5">
              <span class="material-symbols-outlined text-primary text-[18px]">photo_camera</span>
              <span>Fotografía del Accesorio</span>
            </label>
            <span class="text-xs font-semibold text-secondary">Vista previa</span>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-space-md">
            <div class="relative w-28 h-28 shrink-0 rounded-2xl overflow-hidden bg-surface-container-low border border-surface-container shadow-inner flex items-center justify-center">
              <img width="112" height="112" loading="lazy" style="aspect-ratio: 1/1;" alt="Fotografía del producto" title="Fotografía del producto" class="w-full h-full object-cover" id="editProdImg" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww"/>
            </div>

            <div class="flex-1 flex flex-col justify-center space-y-space-xs w-full">
              <label class="block font-label-sm text-label-sm text-secondary font-medium" for="editProdImgInput">URL de la imagen:</label>
              <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm border border-surface-container focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all" id="editProdImgInput" placeholder="https://ejemplo.com/imagen.jpg" type="url"/>

              <!-- Presets rápidos -->
              <div class="pt-1">
                <span class="text-[11px] text-secondary font-medium block mb-1">Preajustes rápidos de catálogo:</span>
                <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
                  <button type="button" class="btn-preset-img px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-surface-container text-[11px] font-semibold text-on-surface border border-surface-container shrink-0 active:scale-95" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww">Funda</button>
                  <button type="button" class="btn-preset-img px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-surface-container text-[11px] font-semibold text-on-surface border border-surface-container shrink-0 active:scale-95" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuDwBW1Tnz4ox8TJimQ2nNWfY6o33DXFVI_9hnHGKzzl3XJhpYMd92sEX1p-M2182e_5P1T9-E8ueXBhioGF4oy264i2UoGbNDW_wFjgwrSNzAJjJhAlRcLwnmRjbP3lOMSy1dM0qSLvxcPA4Wzeciz7TUTmcvBPhWTMLu9gKEJNK5yXbrAMIG8EdaCNX49rw4X2MbQ7za9LNvHHrL-orE8zBLnoZbp1y9YNu2Jb_lniNxeofy9PERKBGA">Cable</button>
                  <button type="button" class="btn-preset-img px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-surface-container text-[11px] font-semibold text-on-surface border border-surface-container shrink-0 active:scale-95" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuBrfDhd7aPs8GoEZkbA-xzj03A0JGJv23NKGhczYuRs8EJYYf_q4gvPULwdu7W8msYzasXSZ5CRFCaiereQb0MBGmy_2rZyX803yRgihTlaUjdsvBhZ43BV5z9VhWzAtBp5NCT6sMqRZH17UfXJqbpvnnAVKBFI_dqtFRl2c6VUhREY7ilvtDMv5-2DsAZhazqG9qhIVZnFgDAxPizJb5ovXT5omGmRTXTgZYwc5QvkWW6J76B2YiQrvw">Cargador</button>
                  <button type="button" class="btn-preset-img px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-surface-container text-[11px] font-semibold text-on-surface border border-surface-container shrink-0 active:scale-95" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuDArc9PQMZMX60YZdL2HuhroEsYV6UgzSH87z-kJS4ARnnmSqmNSHgA9qBp7g6F6dHgZFFqTSVgq2gdJp58wHONkBxTxsO8hE0qtwatBHzLpB31H6chYL2O8S5CJSDi-z88o0vFq5sZcG3tsWBWISuppZf-tVqo03v5gno6pOC0TkrrhFGhyhCHAt7jP4NM9ZHobv-4beNobhEKe-UBtNC0__DBtmC90qfTOgVDh-SgPW_fPqxi2Q1q1g">Mica</button>
                  <button type="button" class="btn-preset-img px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-surface-container text-[11px] font-semibold text-on-surface border border-surface-container shrink-0 active:scale-95" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuBEddAYibZMjqLmVbQYfK77Qtk_GR18aEIxR3iZD-Z2oh2vBwMBHO4f5rmtUUOpsECq0Ki6-5kKq2rrbOwb5qTeegm3mwiaDth6G9WXs1pYgShhoy9AIo62Yi2tPtSAwuB9NT8Xg1cpDcF-6cJyQ2S_WpLWIWQIu2INbGpBjXUA7YtOlsTuVV3M7ipH2vBUeAEuuoP8SCLpb0_EussBUxFkyspxVV1X9GEiyd9dr9O0HJLNk35vxy8HOA">Audio</button>
                  <button type="button" class="btn-preset-img px-2.5 py-1 rounded-lg bg-surface-container-low hover:bg-surface-container text-[11px] font-semibold text-on-surface border border-surface-container shrink-0 active:scale-95" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuCoO16TT-tR-wlBrTApCGHxTpxWYKIILFh-fa-B9ONyuxDC7S0ZXI1xdRds3NS2MAjynS8X2uxtjbBTZFQOx3cu80HN_IChP6er-zID8eNdtHMdl2IaINz3QBd6WqP7XAeWK_-CkFA6KuSLUQ3uYW8aLVdzLA0HU-wJ4SV3_opoxIxnm0ropW05_gKwnufdKjkZCa6ege8rRfS1fIRvvjUVG7PXm7gqADoptCJ87melL-SZW9KfqE8rfw">Soporte</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Datos Generales -->
        <div class="p-space-md rounded-2xl bg-surface-container-lowest shadow-sm border border-surface-container space-y-space-sm">
          <div>
            <label class="block font-label-sm text-label-sm text-secondary mb-1 font-medium" for="prod-sku">Código SKU / Referencia</label>
            <div class="flex items-center justify-between px-3 h-12 rounded-xl bg-surface-container-low text-on-surface border border-surface-container">
              <div class="flex items-center space-x-2">
                <span class="material-symbols-outlined text-secondary text-[20px]">qr_code_2</span>
                <span class="font-sku-code text-sku-code tracking-wider text-on-surface font-bold" id="displaySkuText">SKU-000</span>
              </div>
              <button aria-label="Copiar código" class="w-9 h-9 rounded-lg text-primary hover:bg-surface-container active:scale-95 transition-all flex items-center justify-center cursor-pointer" id="copySkuBtn" type="button" title="Copiar SKU">
                <span class="material-symbols-outlined text-[18px]">content_copy</span>
              </button>
            </div>
          </div>

          <div>
            <label class="block font-label-sm text-label-sm text-on-surface mb-1 font-semibold" for="prod-name">Nombre del producto <span class="text-error">*</span></label>
            <input class="w-full h-12 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md border border-surface-container focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary shadow-xs transition-all font-semibold" id="prod-name" name="prod-name" required type="text" value=""/>
          </div>

          <div>
            <label class="block font-label-sm text-label-sm text-on-surface mb-1 font-semibold" for="prod-cat">Categoría</label>
            <div class="relative">
              <select class="w-full h-12 px-3 pr-10 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md border border-surface-container appearance-none focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary shadow-xs transition-all cursor-pointer" id="prod-cat">
                <!-- Llenado dinámicamente -->
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-secondary">expand_more</span>
            </div>
          </div>
        </div>

        <!-- 3. Stock Actual (Solo Lectura Informativo) -->
        <div class="p-space-md rounded-2xl bg-surface-container-lowest shadow-sm border border-surface-container space-y-space-sm">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-1.5">
              <span class="material-symbols-outlined text-primary text-[20px]">inventory</span>
              <span class="font-label-md text-label-md text-on-surface font-bold">Estado de Existencias</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold" id="readOnlyStockBadge">
              OK
            </span>
          </div>

          <div class="p-3 rounded-xl bg-surface-container-low border border-surface-container flex flex-col space-y-2">
            <div class="flex items-baseline justify-between">
              <span class="font-display text-2xl font-bold text-on-surface" id="readOnlyStockNum">0 <span class="text-xs font-medium text-secondary">/ 10 máx.</span></span>
              <span class="font-label-sm text-label-sm text-primary font-bold" id="readOnlyStockPercent">0% capacidad</span>
            </div>
            <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
              <div class="h-full bg-primary rounded-full transition-all duration-300" id="readOnlyStockBar" style="width: 0%"></div>
            </div>
          </div>
          <p class="text-[11px] text-secondary">
            * Para modificar unidades disponibles, utiliza la sección <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}movimientos/`} class="text-primary font-bold underline">Movimientos</a> o el ajuste rápido desde Inicio.
          </p>
        </div>

        <!-- Barra fija inferior -->
        <div class="fixed bottom-0 left-0 right-0 p-space-md bg-surface-container-lowest/95 backdrop-blur-md shadow-2xl border-t border-surface-container flex items-center justify-between gap-space-sm z-30 max-w-xl mx-auto">
          <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}`} class="w-1/3 h-12 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md active:scale-95 transition-all flex items-center justify-center font-bold">
            Cancelar
          </a>
          <button class="flex-1 h-12 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md shadow-primary/20 hover:opacity-95 active:scale-95 transition-all flex items-center justify-center space-x-1.5 cursor-pointer" id="submitEditBtn" type="submit">
            <span class="material-symbols-outlined text-[20px]">save</span>
            <span>Guardar Cambios</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Toast Feedback -->
    <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200" id="editToast">
      <span class="material-symbols-outlined text-tertiary-fixed text-[18px]" id="editToastIcon">check_circle</span>
      <span id="editToastText">Guardado</span>
    </div>
  </main>

  <script>
    import { getStoredInventory, saveInventory, getCategories } from '../utils/inventoryStore.js';
    import type { Product } from '../types/inventory';

    const defaultFallbackImg = 'https://lh3.googleusercontent.com/aida-public/AB6AXuBjt0Mcxje9x7R-yf0Dy2Zd3GFEUEWMUqYbIlnMNgDVTMomF2L7egungbCgUVR6NNoXWfQdHOiQexwlGgmG2JCKak9H9Sl-K1wYznsoCxZkx5uWFxpuM41HyWtVQVt65UV3QsSrtr8m9YdOvkc3N3v0M2o0tD4aeQ-y7MK_fiQbYFUlx_6_ruApS_lYg1lJvveAaEm8dHd9FA-sVRdTBnE5yL3hqk56PHZ8jJvX2O4y15iGeTNLBLCOww';

    const inventory: Product[] = getStoredInventory(true);
    const urlParams = new URLSearchParams(window.location.search);
    const skuParam = urlParams.get('sku');

    let product: Product | undefined = inventory.find(i => i.sku === skuParam);
    if (!product && inventory.length > 0) {
      product = inventory[0];
    }

    const form = document.getElementById('productForm');
    const copyBtn = document.getElementById('copySkuBtn');
    const toast = document.getElementById('editToast');
    const toastText = document.getElementById('editToastText');
    const toastIcon = document.getElementById('editToastIcon');
    const deactivateBtn = document.getElementById('deactivateProductBtn');
    const deactivateText = document.getElementById('deactivateText');
    const deactivateIcon = document.getElementById('deactivateIcon');

    const nameInput = document.getElementById('prod-name') as HTMLInputElement | null;
    const catSelect = document.getElementById('prod-cat') as HTMLSelectElement | null;
    const displaySkuText = document.getElementById('displaySkuText');
    const headerSkuBadge = document.getElementById('headerSkuBadge');
    const imgPreview = document.getElementById('editProdImg') as HTMLImageElement | null;
    const imgInput = document.getElementById('editProdImgInput') as HTMLInputElement | null;

    const readOnlyStockNum = document.getElementById('readOnlyStockNum');
    const readOnlyStockPercent = document.getElementById('readOnlyStockPercent');
    const readOnlyStockBar = document.getElementById('readOnlyStockBar');
    const readOnlyStockBadge = document.getElementById('readOnlyStockBadge');

    function showToastMsg(msg: string, icon = 'check_circle', isError = false) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      if (toastIcon) toastIcon.textContent = icon;
      toast.className = `fixed top-6 left-1/2 -translate-x-1/2 z-50 ${isError ? 'bg-error-container text-on-error-container' : 'bg-on-surface text-surface'} px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-100 transition-opacity duration-200`;
      setTimeout(() => {
        toast.className = 'fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200';
      }, 2500);
    }

    // Cargar categorías dinámicas
    if (catSelect) {
      const categories = getCategories();
      catSelect.innerHTML = '';
      categories.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat;
        opt.textContent = cat;
        catSelect.appendChild(opt);
      });
    }

    // Inicializar datos del producto
    if (product) {
      if (nameInput) nameInput.value = product.name;
      if (catSelect) catSelect.value = product.category;
      if (displaySkuText) displaySkuText.textContent = product.sku;
      if (headerSkuBadge) headerSkuBadge.textContent = product.sku;

      const productImg = product.img || defaultFallbackImg;
      if (imgPreview) imgPreview.src = productImg;
      if (imgInput) imgInput.value = product.img || '';

      // Indicadores de Stock
      const stock = Number(product.stock) || 0;
      const max = Number(product.maxStock) || 10;
      const min = Number(product.minStock) || 5;
      const pct = Math.min(100, Math.round((stock / max) * 100));

      if (readOnlyStockNum) readOnlyStockNum.innerHTML = `${stock} <span class="text-xs font-medium text-secondary">/ ${max} máx.</span>`;
      if (readOnlyStockPercent) readOnlyStockPercent.textContent = `${pct}% capacidad`;
      if (readOnlyStockBar) readOnlyStockBar.style.width = `${pct}%`;

      if (readOnlyStockBadge) {
        if (stock < min) {
          readOnlyStockBadge.textContent = 'Alerta Stock Bajo';
          readOnlyStockBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-error-container text-on-error-container';
        } else {
          readOnlyStockBadge.textContent = 'Stock Normal';
          readOnlyStockBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        }
      }

      // Estado activo/inactivo
      updateDeactivateBtnState();
    } else {
      showToastMsg('No se encontró ningún producto para editar.', 'warning', true);
    }

    function updateDeactivateBtnState() {
      if (!product || !deactivateText || !deactivateIcon || !deactivateBtn) return;
      if (product.activo === false) {
        deactivateText.textContent = 'Reactivar Accesorio';
        deactivateIcon.textContent = 'visibility';
        deactivateBtn.className = 'px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 font-label-sm text-label-sm flex items-center gap-1.5 hover:bg-emerald-200 active:scale-95 transition-all cursor-pointer font-bold shadow-xs';
      } else {
        deactivateText.textContent = 'Desactivar';
        deactivateIcon.textContent = 'visibility_off';
        deactivateBtn.className = 'px-3 py-1.5 rounded-xl bg-error-container text-on-error-container font-label-sm text-label-sm flex items-center gap-1.5 hover:brightness-95 active:scale-95 transition-all cursor-pointer font-bold shadow-xs';
      }
    }

    // Manejo de presets rápidos de imagen
    document.querySelectorAll('.btn-preset-img').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-img');
        if (url) {
          if (imgPreview) imgPreview.src = url;
          if (imgInput) imgInput.value = url;
        }
      });
    });

    imgInput?.addEventListener('input', () => {
      const url = imgInput.value.trim();
      if (imgPreview) {
        imgPreview.src = url || defaultFallbackImg;
      }
    });

    // Copiar SKU al portapapeles
    copyBtn?.addEventListener('click', () => {
      if (!product) return;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(product.sku);
        showToastMsg(`SKU ${product.sku} copiado`, 'content_copy');
      }
    });

    // Desactivar / Reactivar
    deactivateBtn?.addEventListener('click', () => {
      if (!product) return;
      const isCurrentlyActive = product.activo !== false;
      const confirmMsg = isCurrentlyActive 
        ? `¿Confirmas desactivar "${product.name}"? Permanecerá en el sistema con su historial intacto.`
        : `¿Deseas reactivar "${product.name}" en el catálogo visible?`;

      if (confirm(confirmMsg)) {
        product.activo = !isCurrentlyActive;
        const items: Product[] = getStoredInventory(true);
        const idx = items.findIndex(i => i.sku === product?.sku);
        if (idx !== -1) items[idx] = product;
        saveInventory(items);

        updateDeactivateBtnState();
        showToastMsg(product.activo ? 'Accesorio reactivado' : 'Accesorio desactivado', 'done');
      }
    });

    // Guardar cambios
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!product) return;

      const newName = nameInput?.value.trim();
      if (!newName) {
        showToastMsg('El nombre no puede estar vacío.', 'error', true);
        return;
      }

      product.name = newName;
      product.category = catSelect?.value || product.category;
      product.img = imgInput?.value.trim() || product.img || defaultFallbackImg;
      product.lastUpdated = new Date().toISOString().split('T')[0];

      const items: Product[] = getStoredInventory(true);
      const idx = items.findIndex(i => i.sku === product.sku);
      if (idx !== -1) items[idx] = product;
      saveInventory(items);

      showToastMsg('Detalles guardados exitosamente', 'done_all');
      setTimeout(() => {
        const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
        window.location.href = baseUrl;
      }, 700);
    });
  </script>
</Layout>
