---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Express - Reportes y Consulta de Movimientos">
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile">
    <div class="flex flex-col w-full pb-24 space-y-space-md">
      <!-- Encabezado Limpio y Bien Estructurado -->
      <header class="w-full flex items-center justify-between py-space-xs pt-2">
        <div class="flex items-center gap-space-sm">
          <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}`} aria-label="Volver atrás" class="w-10 h-10 flex items-center justify-center rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors active:scale-95 text-on-surface shadow-xs">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
          </a>
          <div>
            <h1 class="text-2xl font-bold text-on-surface tracking-tight leading-tight">Reportes de Inventario</h1>
            <p class="text-sm text-secondary font-medium mt-0.5">Consulta de transacciones, salidas, entradas y auditoría por operador</p>
          </div>
        </div>
        <!-- Botón Exportar CSV -->
        <button class="flex items-center gap-1.5 h-11 px-4 bg-surface-container-lowest text-primary rounded-xl shadow-sm border border-primary/20 hover:bg-primary hover:text-on-primary transition-all active:scale-95 cursor-pointer font-bold text-sm" id="btn-export-csv" type="button">
          <span class="material-symbols-outlined text-[20px]">download</span>
          <span>Exportar CSV</span>
        </button>
      </header>

      <!-- KPIs Diferenciados Visualmente -->
      <section class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- KPI 1: Unidades Vendidas / Despachadas (Azul Primario Enmarcado) -->
        <div class="bg-blue-50/70 border-2 border-blue-200/80 rounded-2xl p-4 shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-800">Unidades Vendidas / Salidas</span>
            <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-[18px]">shopping_cart_checkout</span>
            </div>
          </div>
          <div class="flex items-baseline gap-1.5 my-1">
            <span class="text-3xl font-extrabold text-blue-900 font-display" id="kpiSalesUnits">0</span>
            <span class="text-xs font-semibold text-blue-700">unid. despachadas</span>
          </div>
          <span class="text-[11px] font-medium text-blue-600">Total rebajado por ventas de piso</span>
        </div>

        <!-- KPI 2: Unidades por Reponer (Ámbar Alerta Enmarcado) -->
        <div class="bg-amber-50/70 border-2 border-amber-200/80 rounded-2xl p-4 shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Unidades por Reponer</span>
            <div class="w-8 h-8 rounded-xl bg-amber-600 text-white flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-[18px]">warning</span>
            </div>
          </div>
          <div class="flex items-baseline gap-1.5 my-1">
            <span class="text-3xl font-extrabold text-amber-900 font-display" id="kpiToRestockUnits">0</span>
            <span class="text-xs font-semibold text-amber-700">unid. faltantes</span>
          </div>
          <span class="text-[11px] font-medium text-amber-700" id="kpiToRestockSubtitle">Para completar capacidad de 10 max</span>
        </div>

        <!-- KPI 3: Stock Real en Piso (Existencias Activas - Verde Esmeralda Enmarcado) -->
        <div class="bg-emerald-50/70 border-2 border-emerald-200/80 rounded-2xl p-4 shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Stock Real en Piso</span>
            <div class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-xs">
              <span class="material-symbols-outlined text-[18px]">inventory_2</span>
            </div>
          </div>
          <div class="flex items-baseline gap-1.5 my-1">
            <span class="text-3xl font-extrabold text-emerald-900 font-display" id="kpiTotalStockUnits">0</span>
            <span class="text-xs font-semibold text-emerald-700">unid. disponibles</span>
          </div>
          <span class="text-[11px] font-medium text-emerald-700">Existencias físicas activas en tienda</span>
        </div>
      </section>

      <!-- Barra de Filtros y Consulta de la Base de Datos -->
      <section class="w-full bg-surface-container-lowest rounded-2xl p-4 shadow-sm border border-surface-container">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[20px]">calendar_month</span>
              <span class="text-sm font-bold text-on-surface">Consulta de Movimientos por Fecha</span>
            </div>
            <span class="text-xs font-semibold text-on-surface-variant bg-surface-container px-2.5 py-1 rounded-full">
              Tu Cell Express
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-4 gap-2">
            <div>
              <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface text-sm font-medium focus:outline-none focus:ring-2 focus:ring-primary border border-surface-container" id="datePicker" type="date"/>
            </div>
            <button class="h-11 rounded-xl bg-primary text-on-primary font-bold text-xs shadow-xs hover:opacity-95 active:scale-95 transition-all" id="btnFilterToday" type="button">
              Movimientos de Hoy
            </button>
            <button class="h-11 rounded-xl bg-surface-container text-on-surface font-bold text-xs hover:bg-surface-container-high active:scale-95 transition-all" id="btnFilter7Days" type="button">
              Últimos 7 Días
            </button>
            <button class="h-11 rounded-xl bg-surface-container-low text-secondary font-bold text-xs hover:text-on-surface active:scale-95 transition-all border border-surface-container" id="btnFilterAll" type="button">
              Ver Todo el Historial
            </button>
          </div>
        </div>
      </section>

      <!-- Contador de registros filtrados -->
      <div class="flex items-center justify-between px-1">
        <div class="flex items-center gap-1.5 text-secondary text-xs font-semibold">
          <span class="material-symbols-outlined text-[18px] text-primary">receipt_long</span>
          <span id="recordCountText">Cargando base de datos de movimientos...</span>
        </div>
      </div>

      <!-- Tabla de Transacciones con Operador -->
      <div class="w-full bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden border border-surface-container">
        <div class="overflow-x-auto w-full">
          <table class="w-full min-w-[700px] border-collapse text-left" id="reportsTable">
            <thead>
              <tr class="bg-surface-container-low text-xs font-bold text-secondary uppercase tracking-wider border-b border-surface-container">
                <th class="py-3 px-4">Producto & SKU</th>
                <th class="py-3 px-4">Fecha & Hora</th>
                <th class="py-3 px-3 text-center">Operación</th>
                <th class="py-3 px-3 text-center bg-surface-container font-bold text-on-surface">Unidades</th>
                <th class="py-3 px-4">Responsable / Operador</th>
                <th class="py-3 px-4 text-right">Observaciones</th>
              </tr>
            </thead>
            <tbody class="text-sm text-on-surface divide-y divide-surface-container-low" id="reportsTableBody">
              <!-- Cargado dinámicamente -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Feedback Toast -->
      <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg text-xs font-bold flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200" id="reportToast">
        <span class="material-symbols-outlined text-tertiary-fixed text-[18px]" id="reportToastIcon">check_circle</span>
        <span id="reportToastText">Acción completada</span>
      </div>
    </div>
  </main>

  <script>
    import { getStoredInventory, getStoredMovements } from '../utils/inventoryStore.js';
    import type { Product, Movement } from '../types/inventory';

    let allMovements: Movement[] = [];
    let filteredMovements: Movement[] = [];

    const toast = document.getElementById('reportToast');
    const toastText = document.getElementById('reportToastText');
    const toastIcon = document.getElementById('reportToastIcon');

    function showToast(msg: string, icon = 'check_circle') {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      if (toastIcon) toastIcon.textContent = icon;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => toast.classList.add('opacity-0', 'pointer-events-none'), 2200);
    }

    function refreshData() {
      allMovements = getStoredMovements();
      const inventory: Product[] = getStoredInventory(false);

      // Calcular KPIs
      let salesCount = 0;
      allMovements.forEach(m => {
        if (m.tipo === 'salida' && !m.revertido) {
          salesCount += Number(m.cantidad) || 0;
        }
      });

      let toRestockCount = 0;
      let totalStockReal = 0;
      inventory.forEach(i => {
        const stock = Number(i.stock) || 0;
        const max = Number(i.maxStock) || 10;
        totalStockReal += stock;
        if (stock < (Number(i.minStock) || 5)) {
          toRestockCount += Math.max(0, max - stock);
        }
      });

      const kpiSales = document.getElementById('kpiSalesUnits');
      const kpiToRestock = document.getElementById('kpiToRestockUnits');
      const kpiTotalStock = document.getElementById('kpiTotalStockUnits');

      if (kpiSales) kpiSales.textContent = salesCount.toString();
      if (kpiToRestock) kpiToRestock.textContent = `+${toRestockCount}`;
      if (kpiTotalStock) kpiTotalStock.textContent = totalStockReal.toString();

      filteredMovements = [...allMovements];
      renderTable(filteredMovements);
    }

    function renderTable(movements: Movement[]) {
      const tbody = document.getElementById('reportsTableBody');
      const recordCountText = document.getElementById('recordCountText');
      if (!tbody) return;
      tbody.innerHTML = '';

      if (recordCountText) {
        recordCountText.textContent = `Mostrando ${movements.length} movimientos en la base de datos`;
      }

      if (movements.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="py-12 text-center text-secondary text-sm">
              <span class="material-symbols-outlined text-[36px] text-outline block mb-1">search_off</span>
              No hay movimientos registrados para el filtro seleccionado.
            </td>
          </tr>
        `;
        return;
      }

      movements.forEach(m => {
        const isEntry = m.tipo === 'entrada' || m.tipo === 'reposicion';
        const isReversion = m.tipo === 'reversion';
        const isAjuste = m.tipo === 'ajuste';

        let badgeStyle = 'bg-rose-100 text-rose-800 border-rose-200';
        let badgeLabel = 'Salida (-)';
        let qtyPrefix = '-';

        if (isEntry) {
          badgeStyle = 'bg-emerald-100 text-emerald-800 border-emerald-200';
          badgeLabel = 'Entrada (+)';
          qtyPrefix = '+';
        } else if (isReversion) {
          badgeStyle = 'bg-purple-100 text-purple-800 border-purple-200';
          badgeLabel = 'Reversión (↺)';
          qtyPrefix = '↺';
        } else if (isAjuste) {
          badgeStyle = 'bg-blue-100 text-blue-800 border-blue-200';
          badgeLabel = 'Ajuste / Registro (⚙)';
          qtyPrefix = '=';
        }

        const dateObj = new Date(m.fechaHora);
        const formattedDate = dateObj.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) + ' · ' + dateObj.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

        const operadorResponsable = (m as any).operador || 'Alejandro (Admin)';

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-surface-container-low/50 transition-colors';
        tr.innerHTML = `
          <!-- Producto & SKU -->
          <td class="py-3 px-4">
            <div class="flex flex-col">
              <span class="font-bold text-on-surface">${m.productName || m.sku}</span>
              <span class="font-sku-code text-[11px] text-secondary font-semibold">${m.sku}</span>
            </div>
          </td>

          <!-- Fecha & Hora -->
          <td class="py-3 px-4 text-xs text-secondary font-medium whitespace-nowrap">
            ${formattedDate}
          </td>

          <!-- Tipo de Operación -->
          <td class="py-3 px-3 text-center">
            <span class="px-2.5 py-1 rounded-full text-xs font-bold border ${badgeStyle} inline-block">
              ${badgeLabel}
            </span>
          </td>

          <!-- Cantidad de Unidades -->
          <td class="py-3 px-3 text-center font-bold text-sm bg-surface-container-low/40">
            <span class="${isEntry ? 'text-emerald-700' : (isReversion ? 'text-purple-700' : (isAjuste ? 'text-blue-700' : 'text-rose-700'))}">
              ${qtyPrefix}${isAjuste ? m.stockResultante : m.cantidad} unid.
            </span>
          </td>

          <!-- Responsable / Operador -->
          <td class="py-3 px-4">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-on-surface">
              <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-[10px]">
                ${operadorResponsable.charAt(0)}
              </span>
              <span>${operadorResponsable}</span>
            </div>
          </td>

          <!-- Observaciones / Estado -->
          <td class="py-3 px-4 text-right text-xs text-secondary">
            ${m.revertido ? '<span class="px-2 py-0.5 rounded bg-error-container text-error font-bold mr-1">Revertido</span>' : ''}
            <span>${m.nota || '-'}</span>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // --- FILTROS DE FECHA ---
    const datePicker = document.getElementById('datePicker') as HTMLInputElement | null;

    datePicker?.addEventListener('change', (e) => {
      const chosen = (e.target as HTMLInputElement).value;
      if (!chosen) return;
      filteredMovements = allMovements.filter(m => m.fechaHora.startsWith(chosen));
      renderTable(filteredMovements);
      showToast(`Filtrado por fecha: ${chosen}`, 'calendar_today');
    });

    document.getElementById('btnFilterToday')?.addEventListener('click', () => {
      const todayStr = new Date().toISOString().split('T')[0];
      if (datePicker) datePicker.value = todayStr;
      filteredMovements = allMovements.filter(m => m.fechaHora.startsWith(todayStr));
      renderTable(filteredMovements);
      showToast('Mostrando movimientos de HOY', 'today');
    });

    document.getElementById('btnFilter7Days')?.addEventListener('click', () => {
      if (datePicker) datePicker.value = '';
      const sevenDaysAgoMs = Date.now() - (86400000 * 7);
      filteredMovements = allMovements.filter(m => new Date(m.fechaHora).getTime() >= sevenDaysAgoMs);
      renderTable(filteredMovements);
      showToast('Mostrando últimos 7 días', 'date_range');
    });

    document.getElementById('btnFilterAll')?.addEventListener('click', () => {
      if (datePicker) datePicker.value = '';
      filteredMovements = [...allMovements];
      renderTable(filteredMovements);
      showToast('Mostrando todo el historial', 'storage');
    });

    // --- EXPORTACIÓN CSV ---
    document.getElementById('btn-export-csv')?.addEventListener('click', function() {
      const btn = this as HTMLButtonElement;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Generando...</span>';

      const csvRows = [
        ['ID Movimiento', 'Fecha y Hora', 'SKU', 'Producto', 'Operacion', 'Cantidad (Unidades)', 'Stock Resultante', 'Operador Responsable', 'Observaciones', 'Revertido']
      ];

      filteredMovements.forEach(m => {
        csvRows.push([
          m.id,
          m.fechaHora,
          m.sku,
          `"${(m.productName || m.sku).replace(/"/g, '""')}"`,
          m.tipo,
          m.cantidad.toString(),
          (m.stockResultante || '').toString(),
          `"${((m as any).operador || 'Alejandro (Admin)').replace(/"/g, '""')}"`,
          `"${(m.nota || '').replace(/"/g, '""')}"`,
          m.revertido ? 'SI' : 'NO'
        ]);
      });

      const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + csvRows.map(e => e.join(',')).join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `Tu_Cell_Express_Reporte_Inventario_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[18px] text-emerald-600">check_circle</span><span>¡Descargado!</span>';
        showToast('Reporte exportado en CSV exitosamente', 'download');
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      }, 600);
    });

    // Carga inicial
    refreshData();

    window.addEventListener('inventory-updated', refreshData);
    window.addEventListener('movements-updated', refreshData);
  </script>
</Layout>
