---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu Cell Express - Consulta Histórica y Reportes">
  <main class="flex-1 flex flex-col relative w-full bg-surface px-gutter-mobile">
    <div class="flex flex-col w-full pb-24">
      <!-- Header Section -->
      <header class="w-full flex items-center justify-between py-space-sm mb-space-sm pt-2">
        <div class="flex items-center gap-space-sm">
          <a href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}`} aria-label="Volver atrás" class="w-touch-min h-touch-min flex items-center justify-center rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors active:scale-95 text-on-surface">
            <span class="material-symbols-outlined text-[22px]">arrow_back</span>
          </a>
          <div>
            <div class="flex items-center gap-space-2xs">
              <h1 class="font-headline-sm text-headline-sm text-on-surface">Base de Datos &amp; Reportes</h1>
              <span class="bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm px-space-xs py-0.5 rounded-full">Histórico Inmutable</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Consulta por fechas de ventas, entradas y salidas de Tu Cell Expres</p>
          </div>
        </div>
        <button class="flex items-center gap-space-2xs h-10 px-space-md bg-surface-container-lowest text-primary rounded-xl shadow-sm hover:bg-surface-container-low transition-all active:scale-95 cursor-pointer" id="btn-export-csv" type="button">
          <span class="material-symbols-outlined text-[20px]">download</span>
          <span class="font-label-md text-label-md">Exportar CSV</span>
        </button>
      </header>

      <!-- Date Query & Branch Selector Bar -->
      <section class="w-full bg-surface-container-lowest rounded-xl p-space-md mb-space-md shadow-sm border border-surface-container">
        <div class="flex flex-col gap-space-sm">
          <div class="flex items-center justify-between">
            <span class="font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1.5">
              <span class="material-symbols-outlined text-primary text-[20px]">calendar_today</span>
              <span>Consulta de Base de Datos por Fecha</span>
            </span>
            <span class="font-body-sm text-body-sm text-on-surface-variant bg-surface-container-low px-3 py-1 rounded-lg">
              Tienda Tu Cell Expres
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-xs">
            <div>
              <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1" for="datePicker">Filtrar por Día Específico</label>
              <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary" id="datePicker" type="date"/>
            </div>

            <div class="sm:col-span-2 flex items-end gap-2">
              <button class="flex-1 h-11 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm font-semibold shadow-sm hover:opacity-95 transition-all" id="btnFilterToday" type="button">
                Registros de Hoy
              </button>
              <button class="flex-1 h-11 rounded-xl bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold hover:bg-surface-container-high transition-all" id="btnFilter7Days" type="button">
                Últimos 7 Días
              </button>
              <button class="flex-1 h-11 rounded-xl bg-surface-container-low text-secondary font-label-sm text-label-sm hover:text-on-surface transition-all" id="btnFilterAll" type="button">
                Ver Todo el Histórico
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- KPI Database Totals -->
      <section class="w-full grid grid-cols-3 gap-space-2xs sm:gap-space-sm mb-space-md">
        <!-- Despachos por Ventas -->
        <div class="bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Unidades Despachadas</span>
            <span class="w-6 h-6 rounded-full bg-primary-fixed flex items-center justify-center text-on-primary-fixed">
              <span class="material-symbols-outlined text-[16px]">shopping_cart_checkout</span>
            </span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-display text-headline-lg text-primary font-bold" id="kpiSalesUnits">0</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">unid.</span>
          </div>
          <span class="text-[11px] font-label-sm text-secondary mt-1">Salidas por venta registradas</span>
        </div>

        <!-- Entradas de Reabastecimiento -->
        <div class="bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Reabastecimiento</span>
            <span class="w-6 h-6 rounded-full bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed">
              <span class="material-symbols-outlined text-[16px]">add_task</span>
            </span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-display text-headline-lg text-tertiary font-bold" id="kpiEntryUnits">+0</span>
            <span class="font-body-sm text-body-sm text-tertiary">unid.</span>
          </div>
          <span class="text-[11px] font-label-sm text-tertiary mt-1">Ingresos a piso</span>
        </div>

        <!-- Mermas y Ajustes -->
        <div class="bg-surface-container-lowest rounded-xl p-space-sm shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between mb-1">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Mermas / Bajas</span>
            <span class="w-6 h-6 rounded-full bg-error-container flex items-center justify-center text-error">
              <span class="material-symbols-outlined text-[16px]">delete_sweep</span>
            </span>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-display text-headline-lg text-error font-bold" id="kpiMermasUnits">0</span>
            <span class="font-body-sm text-body-sm text-error">unid.</span>
          </div>
          <span class="text-[11px] font-label-sm text-error mt-1">Retiros y ajustes de piso</span>
        </div>
      </section>

      <!-- Sub-bar Summary -->
      <div class="w-full flex items-center justify-between mb-space-xs px-1">
        <div class="flex items-center gap-1.5 text-on-surface-variant font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[18px]">storage</span>
          <span id="recordCountText">Cargando base de datos...</span>
        </div>
        <div class="flex items-center gap-space-2xs text-tertiary font-label-sm text-label-sm font-medium">
          <span class="w-2 h-2 rounded-full bg-tertiary"></span>
          <span>BD Inmutable Activa</span>
        </div>
      </div>

      <!-- Main Database Log Table -->
      <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden mb-space-md border border-surface-container">
        <div class="overflow-x-auto w-full">
          <table class="w-full min-w-[680px] border-collapse text-left" id="reportsTable">
            <thead>
              <tr class="bg-surface-container-low font-label-sm text-label-sm text-on-surface-variant tracking-wider">
                <th class="py-space-sm px-space-md">FECHA Y HORA</th>
                <th class="py-space-sm px-space-md">PRODUCTO / SKU</th>
                <th class="py-space-sm px-space-xs text-center">TIPO DE OPERACIÓN</th>
                <th class="py-space-sm px-space-xs text-center font-semibold text-on-surface bg-surface-container">CANTIDAD</th>
                <th class="py-space-sm px-space-md text-right">OBSERVACIÓN / ESTADO</th>
              </tr>
            </thead>
            <tbody class="font-body-md text-body-md text-on-surface" id="reportsTableBody">
              <!-- Skeleton loading state before JS populates table -->
              <tr>
                <td colspan="5" class="p-space-md">
                  <div class="flex flex-col gap-2">
                    <div class="h-6 w-full skeleton-box rounded-lg"></div>
                    <div class="h-6 w-full skeleton-box rounded-lg"></div>
                    <div class="h-6 w-3/4 skeleton-box rounded-lg"></div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="p-space-sm bg-surface-container-low/60 flex items-center justify-between text-on-surface-variant font-body-sm text-body-sm">
          <span>Base de datos persistente: Los productos retirados conservan su historial de ventas.</span>
          <div class="flex items-center gap-1 text-primary">
            <span class="material-symbols-outlined text-[16px]">verified_user</span>
            <span>Tu Cell Expres Ledger</span>
          </div>
        </div>
      </div>

      <!-- Feedback Toast -->
      <div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-on-surface text-surface px-4 py-2.5 rounded-full shadow-lg font-label-sm text-label-sm flex items-center gap-2 opacity-0 pointer-events-none transition-opacity duration-200" id="reportToast">
        <span class="material-symbols-outlined text-tertiary-fixed text-[18px]" id="reportToastIcon">check_circle</span>
        <span id="reportToastText">Acción completada</span>
      </div>
    </div>
  </main>

  <script is:inline>
    const STORE_KEY = 'stock_movil_inventory_v1';
    const DB_LEDGER_KEY = 'tu_cell_expres_db_v1';

    const defaultLedger = [
      { id: 'tx-101', timestamp: new Date(Date.now() - 86400000 * 4).toISOString(), dateStr: new Date(Date.now() - 86400000 * 4).toISOString().split('T')[0], sku: 'SKU-092', productName: 'Funda Silicona Case iPhone 15 Pro', type: 'VENTA', quantity: -5, notes: 'Despacho por venta en mostrador' },
      { id: 'tx-102', timestamp: new Date(Date.now() - 86400000 * 3).toISOString(), dateStr: new Date(Date.now() - 86400000 * 3).toISOString().split('T')[0], sku: 'SKU-104', productName: 'Mica Vidrio Templado 9D iPhone', type: 'VENTA', quantity: -12, notes: 'Venta masiva en mostrador' },
      { id: 'tx-103', timestamp: new Date(Date.now() - 86400000 * 3).toISOString(), dateStr: new Date(Date.now() - 86400000 * 3).toISOString().split('T')[0], sku: 'SKU-104', productName: 'Mica Vidrio Templado 9D iPhone', type: 'MERMA', quantity: -2, notes: 'Empaque dañado en exhibición' },
      { id: 'tx-104', timestamp: new Date(Date.now() - 86400000 * 2).toISOString(), dateStr: new Date(Date.now() - 86400000 * 2).toISOString().split('T')[0], sku: 'SKU-141', productName: 'Cargador Rápido 30W USB-C GaN', type: 'ENTRADA', quantity: 10, notes: 'Reabastecimiento semanal a estante' },
      { id: 'tx-105', timestamp: new Date(Date.now() - 86400000 * 1).toISOString(), dateStr: new Date(Date.now() - 86400000 * 1).toISOString().split('T')[0], sku: 'SKU-520', productName: 'Soporte Magnético para Auto', type: 'VENTA', quantity: -4, notes: 'Despacho en mostrador' },
      { id: 'tx-106', timestamp: new Date().toISOString(), dateStr: new Date().toISOString().split('T')[0], sku: 'SKU-077', productName: 'Cable MagSafe Trenzado 1.5m', type: 'ENTRADA', quantity: 5, notes: 'Reabastecimiento de vitrina' }
    ];

    function getActiveInventorySKUs() {
      const raw = localStorage.getItem(STORE_KEY);
      if (!raw) return [];
      try {
        const items = JSON.parse(raw);
        return items.map(i => i.sku);
      } catch (e) { return []; }
    }

    function loadDatabaseLedger() {
      const raw = localStorage.getItem(DB_LEDGER_KEY);
      if (!raw) {
        localStorage.setItem(DB_LEDGER_KEY, JSON.stringify(defaultLedger));
        return defaultLedger;
      }
      try {
        return JSON.parse(raw);
      } catch (e) {
        localStorage.setItem(DB_LEDGER_KEY, JSON.stringify(defaultLedger));
        return defaultLedger;
      }
    }

    let fullLedger = loadDatabaseLedger();
    let filteredLedger = [...fullLedger];

    const toast = document.getElementById('reportToast');
    const toastText = document.getElementById('reportToastText');
    const toastIcon = document.getElementById('reportToastIcon');

    function showToast(msg, icon = 'check_circle') {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      if (toastIcon) toastIcon.textContent = icon;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => toast.classList.add('opacity-0', 'pointer-events-none'), 2200);
    }

    function renderDatabaseTable(records) {
      const tbody = document.getElementById('reportsTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const activeSKUs = getActiveInventorySKUs();
      let salesSum = 0;
      let entrySum = 0;
      let mermasSum = 0;

      if (records.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-space-xl text-center text-on-surface-variant font-body-md">
              <span class="material-symbols-outlined text-[32px] text-secondary block mb-1">search_off</span>
              No hay registros guardados en la base de datos para el filtro seleccionado.
            </td>
          </tr>
        `;
      } else {
        records.forEach(item => {
          const isDeletedProduct = !activeSKUs.includes(item.sku);
          const dateObj = new Date(item.timestamp);
          const formattedDate = dateObj.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) + ' ' + dateObj.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

          if (item.type === 'VENTA') salesSum += Math.abs(item.quantity);
          if (item.type === 'ENTRADA') entrySum += Math.abs(item.quantity);
          if (item.type === 'MERMA' || item.type === 'BAJA_PRODUCTO') mermasSum += Math.abs(item.quantity);

          let badgeClass = 'bg-primary-fixed text-on-primary-fixed';
          let badgeText = item.type;
          if (item.type === 'VENTA') { badgeClass = 'bg-primary-container text-on-primary'; badgeText = 'Ventas Mostrador'; }
          else if (item.type === 'ENTRADA') { badgeClass = 'bg-tertiary-fixed text-on-tertiary-fixed'; badgeText = 'Reabastecimiento'; }
          else if (item.type === 'MERMA') { badgeClass = 'bg-error-container text-on-error-container'; badgeText = 'Merma Extraída'; }
          else if (item.type === 'ALTA_PRODUCTO') { badgeClass = 'bg-surface-container-high text-on-surface'; badgeText = 'Nuevo Producto'; }
          else if (item.type === 'BAJA_PRODUCTO') { badgeClass = 'bg-error text-on-error'; badgeText = 'Eliminado de Vitrina'; }

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-surface-container-low/40 transition-colors border-b border-surface-container-low';
          tr.innerHTML = `
            <td class="py-space-sm px-space-md font-sku-code text-sku-code text-secondary whitespace-nowrap">${formattedDate}</td>
            <td class="py-space-sm px-space-md">
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-1.5">
                  <span class="font-label-md text-label-md text-on-surface font-semibold truncate">${item.productName}</span>
                  ${isDeletedProduct ? '<span class="px-1.5 py-0.2 rounded bg-error-container text-error text-[10px] font-bold">Retirado de Vitrina</span>' : ''}
                </div>
                <span class="font-sku-code text-sku-code text-on-surface-variant uppercase">${item.sku}</span>
              </div>
            </td>
            <td class="py-space-sm px-space-xs text-center">
              <span class="px-2.5 py-0.5 rounded-full font-label-sm text-label-sm font-semibold inline-block ${badgeClass}">
                ${badgeText}
              </span>
            </td>
            <td class="py-space-sm px-space-xs text-center font-data-tabular text-data-tabular font-bold bg-surface-container-low">
              ${item.quantity > 0 ? '+' + item.quantity : item.quantity} unid.
            </td>
            <td class="py-space-sm px-space-md text-right font-body-sm text-body-sm text-on-surface-variant">
              ${item.notes || 'Registro automatizado'}
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      const kpiSales = document.getElementById('kpiSalesUnits');
      const kpiEntry = document.getElementById('kpiEntryUnits');
      const kpiMermas = document.getElementById('kpiMermasUnits');
      const recordCountText = document.getElementById('recordCountText');

      if (kpiSales) kpiSales.textContent = salesSum;
      if (kpiEntry) kpiEntry.textContent = '+' + entrySum;
      if (kpiMermas) kpiMermas.textContent = mermasSum;
      if (recordCountText) recordCountText.textContent = `Mostrando ${records.length} transacciones guardadas`;
    }

    // Date Filter Logic
    const datePicker = document.getElementById('datePicker');
    
    datePicker?.addEventListener('change', (e) => {
      const chosenDateStr = e.target.value;
      if (!chosenDateStr) return;
      filteredLedger = fullLedger.filter(item => item.dateStr === chosenDateStr);
      renderDatabaseTable(filteredLedger);
      showToast(`Mostrando registros de fecha: ${chosenDateStr}`, 'calendar_today');
    });

    document.getElementById('btnFilterToday')?.addEventListener('click', () => {
      const todayStr = new Date().toISOString().split('T')[0];
      if (datePicker) datePicker.value = todayStr;
      filteredLedger = fullLedger.filter(item => item.dateStr === todayStr);
      renderDatabaseTable(filteredLedger);
      showToast('Mostrando transacciones de HOY', 'today');
    });

    document.getElementById('btnFilter7Days')?.addEventListener('click', () => {
      if (datePicker) datePicker.value = '';
      const sevenDaysAgoMs = Date.now() - (86400000 * 7);
      filteredLedger = fullLedger.filter(item => new Date(item.timestamp).getTime() >= sevenDaysAgoMs);
      renderDatabaseTable(filteredLedger);
      showToast('Mostrando transacciones de los últimos 7 días', 'date_range');
    });

    document.getElementById('btnFilterAll')?.addEventListener('click', () => {
      if (datePicker) datePicker.value = '';
      filteredLedger = [...fullLedger];
      renderDatabaseTable(filteredLedger);
      showToast('Mostrando todo el historial de la base de datos', 'storage');
    });

    // CSV Download Functionality
    document.getElementById('btn-export-csv')?.addEventListener('click', function() {
      const btn = this;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[20px]">sync</span><span class="font-label-md text-label-md">Generando...</span>';

      const csvRows = [
        ['ID Transaccion', 'Fecha y Hora', 'SKU', 'Producto', 'Tipo Operacion', 'Cantidad (Unid)', 'Observaciones']
      ];

      filteredLedger.forEach(item => {
        csvRows.push([
          item.id,
          item.timestamp,
          item.sku,
          item.productName.replace(/,/g, ''),
          item.type,
          item.quantity,
          (item.notes || '').replace(/,/g, '')
        ]);
      });

      const csvContent = 'data:text/csv;charset=utf-8,' + csvRows.map(e => e.join(',')).join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', 'Tu_Cell_Expres_Reporte_BD.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px] text-tertiary">check_circle</span><span class="font-label-md text-label-md">¡Descargado!</span>';
        showToast('Base de datos exportada en CSV', 'download');
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 2000);
      }, 700);
    });

    // Initial render
    renderDatabaseTable(fullLedger);
  </script>
</Layout>
