{
  "name": "Tu Cell Express - Control de Inventario",
  "short_name": "Tu Cell Express",
  "description": "App móvil de control y gestión de inventario para tienda de accesorios de celular.",
  "id": "/inventario/",
  "start_url": "/inventario/",
  "scope": "/inventario/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#f8f9ff",
  "theme_color": "#004ac6",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/inventario/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/inventario/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/inventario/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/inventario/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Inventario de Piso",
      "short_name": "Inventario",
      "description": "Consultar y filtrar stock de accesorios",
      "url": "/inventario/",
      "icons": [{ "src": "/inventario/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Nuevo Movimiento",
      "short_name": "Movimientos",
      "description": "Registrar entrada o salida de stock",
      "url": "/inventario/movimientos/",
      "icons": [{ "src": "/inventario/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Alertas de Stock",
      "short_name": "Alertas",
      "description": "Ver accesorios que requieren reposición urgente",
      "url": "/inventario/alertas/",
      "icons": [{ "src": "/inventario/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Reportes y Métricas",
      "short_name": "Reportes",
      "description": "Ver balance y métricas de despacho",
      "url": "/inventario/reportes/",
      "icons": [{ "src": "/inventario/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
